],[30,820,830,1160,1170,1960,1970,4820],[564,12,12,12,12,12],29],[["وَلَا","تُطِعۡ","كُلَّ","حَلَّا[dفٍ]","[dم]َّه[pِي]نٍ"],"Не повинуйся всякому расточителю клятв, презренному,",[200,810,820,1620,1630,2430,2440,3780,3790,5830],[30,500,510,1150,1160,1760,1770,3990,4000,6130],[564,12,12,12,13,13,13],29],[["هَ[gمّ]َا[dزٍ]","[dم]َّشّ[oَا]ٓ[iءِۭ]","[iب]ِنَم[pِي]مٍ"],"хулителю, разносящему сплетни,",[250,2680,2690,5750,5760,7140],[50,2910,2920,6340,6350,8590],[564,13,13,13,13],29],[["مَّ[gنّ]َا[Dعٍ]","[Dل]ِّلۡخَيۡرِ","مُعۡتَدٍ","أَث[pِي]مٍ"],"скупящемуся на добро, преступнику, грешнику,",[300,2340,2350,3600,3610,4850,4860,6110],[40,1780,1790,2960,2970,3920,3930,6470],[564,13,13,13,14,14],29],[["عُتُل[iِّۭ]","[iب]َعۡدَ","ذ[nٰ]لِكَ","زَن[pِي]مٍ"],"жестокому, к тому же самозванцу,",[200,1820,1830,2600,2610,3700,3710,5060],[70,1750,1760,2300,2310,3130,3140,6300],[564,14,14,14,14,14],29],[["أَ[fن]","[fك]َانَ","ذَا","مَا[dلٍ]","[dو]َبَن[pِي]نَ"],"даже если он будет богат и будет иметь сыновей.",[200,1090,1100,1940,1950,2540,2550,4060,4070,5360],[150,1290,1300,1940,1950,2430,2440,3040,3050,6890],[564,14,14,14,14,14,15],29],[["إِذَا","تُتۡلَىٰ","عَلَيۡهِ","ءَايَ[nـٰ]تُنَا","قَالَ","أَسَ[nـٰ]طِيرُ","[wٱ]لۡأَوَّل[pِي]نَ"],"Когда ему читают Наши аяты, он говорит: «Это - легенды древних народов!».",[40,750,760,1830,1840,3000,3010,4990,5000,5850,5860,7810,7820,9740],[30,540,550,1370,1380,2220,2230,3660,3670,4330,4340,5540,5550,8770],[564,15,15,15,15,15,15,15,15],29],[["سَنَسِمُهُ[nۥ]","عَلَى","[wٱ]لۡخُرۡط[pُو]مِ"],"Мы заклеймим его хобот (нос).",[300,1700,1710,2240,2250,9691],[30,1140,1150,1610,1620,4740],[564,1,1,1,1],29],[["إِ[gنّ]َا","بَلَوۡنَ[nـٰ]هُمۡ","كَمَا","بَلَوۡن[uَآ]","أَصۡحَ[nـٰ]بَ","[wٱ]لۡجَ[gنّ]َةِ","إِذۡ","أَ[qقۡ]سَمُو[sاۡ]","لَيَصۡرِمُ[gنّ]َهَا","مُصۡبِح[pِي]نَ"],"Воистину, мы подвергли их испытанию, подобно тому, как мы подвергли испытанию владельцев сада, когда они поклялись, что утром они непременно сорвут их (плоды),",[400,1780,1790,3750,3760,4670,4680,7030,7040,