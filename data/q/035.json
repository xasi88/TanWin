[wٱ]للَّهِ","يَرۡزُقُك[hُم]","[hم]ِّنَ","[wٱ][lل]سَّم[oَا]ٓءِ","وَ[wٱ]لۡأَرۡضِۚ","ل[uَآ]","إِلَ[nـٰ]هَ","إِلَّا","هُوَۖ","فَأَ[gنّ]َىٰ","تُؤۡفَك[pُو]نَ"],"О люди! Помните о милости Аллаха по отношению к вам. Есть ли наряду с Аллахом другой творец, который давал бы вам пропитание с неба и земли? Нет божества, кроме Него! До чего же вы отвращены от истины!",[1850,3090,3100,4040,4050,4960,4970,5830,5840,6730,6740,8050,14450,14730,14740,15060,15070,16270,16280,17010,17020,17970,17980,19930,19940,20250,20260,22560,22570,23860,23870,30460,30470,31420,31430,32430,32440,33250,38250,39690,39700,41250],[150,2840,2850,4050,4060,4810,4820,5530,5540,6240,6250,7890,7900,8250,8260,8550,8560,9480,9490,10290,10300,10900,10910,12560,12570,12790,12800,15010,15020,16550,16560,18380,18390,19120,19130,19870,19880,20730,20740,22500,22510,25090]],[["وَإ[dِن]","[dي]ُكَذِّبُوكَ","فَقَ[qدۡ]","كُذِّبَتۡ","رُسُ[dلٌ]","[dم]ِّ[fن]","[fق]َ[qبۡ]لِكَۚ","وَإِلَى","[wٱ]للَّهِ","تُرۡجَعُ","[wٱ]لۡأُم[pُو]رُ"],"Если они сочтут тебя лжецом, то ведь до тебя посланников также считали лжецами. Но дела возвращаются к Аллаху.",[350,1380,1390,2700,2710,3390,3400,4690,4700,7000,7010,7020,7030,7900,14500,15230,15240,15870,15880,16740,16750,18140],[150,1480,1490,2660,2670,3210,3220,4180,4190,5870,5880,6800,6810,7990,8000,8530,8540,9290,9300,10080,10090,12340]],[["يَ[oـٰٓ]أَيُّهَا","[wٱ][lل][gنّ]َاسُ","إِ[gنّ]َ","وَعۡدَ","[wٱ]للَّهِ","حَ[fقٌّۖ]","[fف]َلَا","تَغُرَّ[gنّ]َكُمُ","[wٱ]لۡحَيَ[sو][nٰ]ةُ","[wٱ][lل]دُّنۡيَاۖ","وَلَا","يَغُرَّ[gنّ]َك[Fُم]","[Fب]ِ[wٱ]للَّهِ","[wٱ]لۡغَر[pُو]رُ"],"О люди! Воистину, обещание Аллаха истинно. Пусть не обольщает вас мирская жизнь, и пусть соблазнитель (дьявол) не обольщает вас относительно Аллаха.",[250,3020,3030,4150,4160,5060,5070,5780,5790,6700,6710,8060,8070,8830,8840,11070,11080,12290,12300,13750,19200,19750,19760,22360,22370,23470,23480,24720],[130,2510,2520,3770,3780,4860,4870,5460,5470,6190,6200,7350,7360,7860,7870,10080,10090,11030,11040,11980,11990,12500,12510,15490,15500,16470,16480,18520]],[["إِ[gنّ]َ","[wٱ][lل]شَّيۡطَ[nـٰ]نَ","لَكُمۡ","عَدُ[fوٌّ]","[fف]َ[wٱ]تَّخِذُوهُ","عَدُوًّاۚ","إِ[gنّ]َمَا","يَ[qدۡ]عُو[sاۡ]","حِزۡبَهُ[nۥ]","لِيَكُونُو[sاۡ]","مِنۡ","أَصۡحَ[nـٰ]بِ","[wٱ][lل]سَّع[pِي]رِ"],"Воистину, дьявол является вашим врагом, так относитесь же к нему как к врагу. Он зовет свою партию к тому, чтобы они стали обитателями Пламени.",[300,1140,1150,2620,2630,3250,3260,4810,4820,6530,6540,8050,13000,14340,14350,15270,15280,16510,16520,17940,17950,18340,18350,19500,19510,20820],[200,1320,1330,2510,2520,3010,3020,4860,4870,6190,6200,7920,7930,9420,9430,10170,10180,11200,11210,12340,12350,12710,12720,13610,13620,15800]],[["ٱلَّذِينَ","كَفَرُو[sاۡ]","لَهُمۡ","عَذَا[fبٌ]","[fش]َدِي[dدٌۖ]","[dو]َ[wٱ]لَّذِينَ","ءَامَنُو[sاۡ]","وَعَمِلُو[sاۡ]","[wٱ][lل]صَّ[nـٰ]لِحَ[nـٰ]تِ","لَه[hُم]","[hم]َّغۡفِرَ[dةٌ]","[dو]َأَ[qجۡ][fرٌ]","[fك]َب[pِي]رٌ"],"Тем, которые не уверовали, уготованы тяжкие мучения. А тем, которые уверовали и совершали праведные деяния, уготованы прощение и великая награда.",[250,1220,1230,2190,2200,2750,2760,4170,4180,5400,12800,13860,13870,15020,15030,15840,15850,17550,17560,18570,18580,20210,20220,21880,21890,23070],[30,1100,1110,1910,1920,2380,2390,4170,4180,6710,6720,7840,7850,8750,8760,9450,9460,10830,10840,12260,12270,13760,13770,15760,15770,17580]],[["أَفَمَ[fن]","[fز]ُيِّنَ","لَهُ[nۥ]","س[oُو]ٓءُ","عَمَلِه[nِۦ]","فَرَءَاهُ","حَسَ[fنًاۖ]","[fف]َإِ[gنّ]َ","[wٱ]للَّهَ","يُضِلُّ","م[dَن]","[dي]َش[oَا]ٓءُ","وَيَهۡدِى","م[dَن]","[dي]َش[oَا]ٓءُۖ","فَلَا","تَذۡهَ[qبۡ]","نَفۡسُكَ","عَلَيۡهِمۡ","حَسَر[nٰ]تٍۚ","إِ[gنّ]َ","[wٱ]للَّهَ","عَلِي[iمُۢ]","[iب]ِمَا","يَصۡنَع[pُو]نَ"],"Разве тот, кому его злодеяние представлено прекрасным и кто считает его благом, равен тому, кто следует прямым путем? Воистину, Аллах вводит в заблуждение того, кого пожелает, и ведет прямым путем того, кого пожелает. Не изводи себя скорбью по ним. Воистину, Аллах знает о том, что они творят.",[200,1300,1310,2320,2330,3070,3080,4810,4820,6100,6110,7360,7370