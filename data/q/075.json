{"id":75,"v":[[["ل[uَآ]","أُ[qقۡ]سِمُ","بِيَوۡمِ","[wٱ]لۡقِيَ[nـٰ]مَةِ"],"Нет, клянусь Днем воскресения!",[50,1750,1760,2890,2900,3980,3990,5600],[50,1070,1080,3330,3340,4210,4220,5410]],[["وَل[uَآ]","أُ[qقۡ]سِمُ","بِ[wٱ][lل][gنّ]َفۡسِ","[wٱ][lل]لَّوَّامَةِ"],"Клянусь душой попрекающей!",[350,2080,2090,3220,3230,5060,5070,7130],[30,2250,2260,3210,3220,5280,5290,6580]],[["أَيَحۡسَبُ","[wٱ]لۡإِ[fنس]َ[nـٰ]نُ","أَلّ[dَن]","[dن]َّ[qجۡ]مَعَ","عِظَامَهُۥ"],"Неужели человек полагает, что Мы не соберем его костей?",[400,1700,1710,3910,3920,5510,5520,6550,6560,8090],[30,1060,1070,3140,3150,4760,4770,5490,5500,6470]],[["بَلَىٰ","قَ[nـٰ]دِرِينَ","عَلَ[uىٰٓ]","أ[dَن]","[dن]ُّسَوِّىَ","بَنَانَهُۥ"],"Конечно! Мы способны восстановить даже кончики его пальцев (или сделать всего его пальцы одинаковыми, так что он не сможет пользоваться ими, как прежде).",[300,1000,1010,2800,2810,4730,4740,5010,5020,7030,7040,8500],[50,640,650,1860,1870,2200,2210,4870,4880,5720,5730,6590]],[["بَلۡ","يُرِيدُ","[wٱ]لۡإِ[fنس]َ[nـٰ]نُ","لِيَفۡجُرَ","أَمَامَهُۥ"],"Но человек желает и впредь совершать грехи.",[200,700,710,1900,1910,4230,4240,5700,5710,7230],[40,400,410,1170,1180,3060,3070,4110,4120,5010]],[["يَسۡــَٔلُ","أَيَّانَ","يَوۡمُ","[wٱ]لۡقِيَ[nـٰ]مَةِ"],"Он спрашивает, когда же наступит День воскресения?",[300,1470,1480,3010,3020,3960,3970,5880],[100,840,850,1810,1820,2510,2520,3690]],[["فَإِذَا","بَرِقَ","[wٱ]لۡبَصَرُ"],"Когда взор будет ошеломлен,",[350,1410,1420,2300,2310,3760],[30,830,840,1470,1480,2400]],[["وَخَسَفَ","[wٱ]لۡقَمَرُ"],"луна затмится,",[300,1360,1370,2820],[60,840,850,1680]],[["وَجُمِعَ","[wٱ][lل]شَّمۡسُ","وَ[wٱ]لۡقَمَرُ"],"а солнце и луна сойдутся.",[250,1240,1250,2530,2540,4220],[30,790,800,1620,1630,2710]],[["يَقُولُ","[wٱ]لۡإِ[fنس]َ[nـٰ]نُ","يَوۡمَئِذٍ","أَيۡنَ","[wٱ]لۡمَفَرُّ"],"В тот день человек скажет: «Куда бежать?».",[400,1490,1500,3910,3920,5770,5780,6650,6660,8150],[70,800,810,2820,2830,4060,4070,4650,4660,5570]],[["كَلَّا","لَا","وَزَرَ"],"О нет! Не будет убежища!",[250,1400,1410,1990,2000,3150],[30,1420,1430,1800,1810,2480]],[["إِلَىٰ","رَبِّكَ","يَوۡمَئِذٍ","[wٱ]لۡمُسۡتَقَرُّ"],"В тот день возвращение будет к твоему Господу.",[200,1020,1030,2200,2210,3950,3960,6030],[30,620,630,1410,1420,2570,2580,4150]],[["يُنَبَّؤُ[sاۡ]","[wٱ]لۡإِ[fنس]َ[nـٰ]نُ","يَوۡمَئِ[iذِۭ]","[iب]ِمَا","قَدَّمَ","وَأَخَّرَ"],"В тот день человеку возвестят о том, что он совершил заранее и что оставил после себя.",[150,1410,1420,3640,3650,5690,5700,6530,6540,7730,7740,9360],[40,1000,1010,2980,2990,4840,4850,5450,5460,6320,6330,7340]],[["بَلِ","[wٱ]لۡإِ[fنس]َ[nـٰ]نُ","عَلَىٰ","نَفۡسِه[nِۦ]","بَصِيرَةٌ"],"Но человек будет свидетельствовать против самого себя,",[40,460,470,2640,2650,3660,3670,5110,5120,6550],[30,410,420,2230,2240,2890,2900,3850,3860,4770]],[["وَلَوۡ","أَلۡقَىٰ","مَعَاذِيرَهُۥ"],"даже если он будет оправдываться.",[350,1070,1080,3150,3160,4470],[30,610,620,1410,1420,2860]],[["لَا","تُحَرِّكۡ","بِه[nِۦ]","لِسَانَكَ","لِتَعۡجَلَ","بِهِۦٓ"],"Не шевели своим языком, повторяя его (Коран), чтобы поскорее запомнить.",[300,810,820,2230,2240,3240,3250,4750,4760,6210,6220,6650],[40,360,370,1390,1400,2020,2030,3070,3080,4050,4060,4410]],[["إِ[gنّ]َ","عَلَيۡنَا","جَمۡعَهُ[nۥ]","وَقُرۡءَانَهُۥ"],"Нам надлежит собрать его и прочесть.",[300,1340,1350,2940,2950,4500,4510,6430],[30,1180,1190,2240,2250,3310,3320,4620]],[["فَإِذَا","قَرَأۡنَ[nـٰ]هُ","فَ[wٱ]تَّبِعۡ","قُرۡءَانَهُۥ"],"Когда же Мы прочтем его, то читай его следом.",[300,1250,1260,3080,3090,4520,4530,6430],[30,760,770,2010,2020,2960,2970,4370]],[["ثُ[gمّ]َ","إِ[gنّ]َ","عَلَيۡنَا","بَيَانَهُۥ"],"Нам надлежит разъяснять его.",[350,1420,1430,2630,2640,4160,4170,5680],[30,1160,1170,2230,2240,3300,3310,4230]],[["كَلَّا","بَلۡ","تُحِبُّونَ","[wٱ]لۡعَاجِلَةَ"],"Но нет! Вы любите жизнь ближнюю",[250,1320,1330,1920,1930,3670,3680,5280],[30,770,780,1120,1130,2370,2380,3550]],[["وَتَذَرُونَ","[wٱ]لۡأَخِرَةَ"],"и пренебрегаете Последней жизнью.",[250,1890,1900,3510],[40,1210,1220,2390]],[["وُجُو[dهٌ]","[dي]َوۡمَئِ[dذٍ]","[dن]َّاضِرَةٌ"],"Одни лица в тот день будут сиять",[350,2150,2160,3850,3860,5740],[30,1620,1630,3200,3210,4420]],[["إِلَىٰ","رَبِّهَا","نَاظِرَةٌ"],"и взирать на своего Господа.",[350,1070,1080,2790,2800,4150],[30,560,570,1610,1620,2540]],[["وَوُجُو[dهٌ]","[dي]َوۡمَئِ[iذِۭ]","[iب]َاسِرَةٌ"],"Другие же лица в тот день будут омрачены.",[250,2500,2510,4720,4730,6100],[30,1760,1770,3840,3850,4920]],[["تَظُ[gنّ]ُ","أ[dَن]","[dي]ُفۡعَلَ","بِهَا","فَاقِرَةٌ"],"Они убедятся о том, что их поразит беда.",[40,1450,1460,2490,2500,3650,3660,4610,4620,6150],[40,1650,1660,2720,2730,3440,3450,4040,4050,5080]],[["كَلّ[uَآ]","إِذَا","بَلَغَتِ","[wٱ][lل]تَّرَاقِىَ"],"Но нет! Когда душа достигнет ключицы,",[400,2510,2520,3380,3390,4630,4640,6620],[30,1530,1540,2780,2790,3640,3650,5050]],[["وَقِيلَ","م[Dَنۡۜ]","[Dر][pَا][qق]ٍ"],"будет сказано: «Кто же прочтет заклинание?».",[300,1550,1560,2200,4150,5230],[30,850,860,1680,1690,4760]],[["وَظَ[gنّ]َ","أَ[gنّ]َهُ","[wٱ]لۡفِر[pَا][qق]ُ"],"Умирающий поймет, что наступило расставание.",[200,1510,1520,3010,3020,4570],[30,1460,1470,2790,2800,5500]],[["وَ[wٱ]لۡتَفَّتِ","[wٱ][lل]سَّاقُ","بِ[wٱ][lل]سّ[pَا][qق]ِ"],"Голень сойдется с голенью (тяготы мирской жизни объединятся с тяготами последней жизни или голени человека будут сложены вместе в саване),",[450,2180,2190,3550,3560,5150],[30,1210,1220,2050,2060,2950]],[["إِلَىٰ","رَبِّكَ","يَوۡمَئِذٍ","[wٱ]لۡمَس[pَا][qق]ُ"],"и в тот день его пригонят к твоему Господу.",[400,1120,1130,2350,2360,4090,4100,5980],[30,520,530,1310,1320,2450,2460,3460]],[["فَلَا","صَدَّقَ","وَلَا","صَلَّىٰ"],"Он не уверовал и не совершал намаз.",[500,1170,1180,2400,2410,3270,3280,4830],[30,540,550,1410,1420,1940,1950,3040]],[["وَلَ[nـٰ]كِ[fن]","[fك]َذَّبَ","وَتَوَلَّىٰ"],"Напротив, он счел это ложью и отвернулся,",[350,2190,2200,3400,3410,5450],[30,1590,1600,2440,2450,3980]],[["ثُ[gمّ]َ","ذَهَبَ","إِلَ[uىٰٓ]","أَهۡلِه[nِۦ]","يَتَمَطَّىٰٓ"],"а затем горделиво отправился к своей семье.",[400,1450,1460,2310,2320,3980,3990,5420,5430,9570],[30,1190,1200,1810,1820,3460,3470,4430,4440,5840]],[["أَوۡلَىٰ","لَكَ","فَأَوۡلَىٰ"],"Горе тебе, горе!",[300,1440,1450,1970,1980,3680],[30,760,770,1130,1140,2430]],[["ثُ[gمّ]َ","أَوۡلَىٰ","لَكَ","فَأَوۡلَىٰٓ"],"Еще раз горе тебе, горе!",[350,1410,1420,2700,2710,3250,3260,5080],[30,1180,1190,2030,2040,2360,2370,3620]],[["أَيَحۡسَبُ","[wٱ]لۡإِ[fنس]َ[nـٰ]نُ","أ[dَن]","[dي]ُتۡرَكَ","سُدًى"],"Неужели человек полагает, что он будет оставлен без присмотра?",[300,1650,1660,3920,3930,4980,4990,6060,6070,8680],[30,1000,1010,3190,3200,4480,4490,5060,5070,5990]],[["أَلَمۡ","يَكُ","نُ[qطۡ]فَ[dةً]","[dم]ّ[dِن]","[dم]َّنِ[dىٍّ]","[dي]ُمۡنَىٰ"],"Разве он не был каплей из семени источаемого?",[350,900,910,1600,1610,3480,3490,4280,4290,6100,6110,8810],[30,530,540,1010,1020,2620,2630,2670,2680,5200,5210,6410]],[["ثُ[gمّ]َ","كَانَ","عَلَقَ[fةً]","[fف]َخَلَقَ","فَسَوَّىٰ"],"Потом он превратился в сгусток крови, после чего Он создал его и придал ему соразмерный облик.",[400,1390,1400,2340,2350,4220,4230,5410,5420,7310],[30,1390,1400,1980,1990,3500,3510,4310,4320,5560]],[["فَجَعَلَ","مِنۡهُ","[wٱ][lل]زَّوۡجَيۡنِ","[wٱ][lل]ذَّكَرَ","وَ[wٱ]لۡأُ[fنث]َىٰٓ"],"Он сотворил из него чету: мужчину и женщину.",[350,1300,1310,2130,2140,3940,3950,5190,5200,8870],[30,780,790,1340,1350,2580,2590,3460,3470,5750]],[["أَلَيۡسَ","ذ[nٰ]لِكَ","بِقَ[nـٰ]دِرٍ","عَلَ[uىٰٓ]","أ[dَن]","[dي]ُحۡــِۧىَ","[wٱ]لۡمَوۡتَىٰ"],"Неужели Он не способен воскресить мертвых?",[400,1360,1370,2550,2560,4220,4230,6130,6140,7070,7080,8150,8160,9970],[30,770,780,1600,1610,2770,2780,3060,3070,5680,5690,6530,6540,8360]]]}