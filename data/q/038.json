{"id":38,"v":[[["[xصٓ]‌ۚ","وَ[wٱ]لۡقُرۡءَانِ","ذِى","[wٱ][lل]ذِّكۡرِ"],"Сад. Клянусь Кораном, содержащим напоминание!",[2760,3300,8500,10530,10540,11400,11410,11870],[70,4880,4890,6430,6440,6620,6630,7840]],[["بَلِ","[wٱ]لَّذِينَ","كَفَرُو[sاۡ]","فِى","عِزَّ[dةٍ]","[dو]َشِق[pَا][qق]ٍ"],"Однако те, которые не веруют, пребывают в гордыне и разладе с истиной.",[400,720,730,1980,1990,3210,3220,3870,3880,5690,5700,7340],[30,450,460,1500,1510,2370,2380,2750,2760,4660,4670,7320]],[["كَمۡ","أَهۡلَكۡنَا","مِ[fن]","[fق]َ[qبۡ]لِه[hِم]","[hم]ِّ[fن]","[fق]َرۡ[fنٍ]","[fف]َنَادَو[sاۡ]","وَّلَاتَ","حِينَ","مَن[pَا]صٍ"],"Как же много поколений погубили Мы до них! Они взывали, но уже было поздно для того, чтобы уклониться.",[400,870,880,2770,2780,3680,3690,4840,4850,6580,6590,8040,8050,9630,9640,10810,10820,11790,11800,13230],[70,440,450,1740,1750,2780,2790,4590,4600,5590,5600,7060,7070,8210,8220,9050,9060,9730,9740,12380]],[["وَعَجِب[oُوٓ][sاۡ]","أَ[fن]","[fج][oَا]ٓءَه[hُم]","[hم]ُّ[fنذ]ِ[dرٌ]","[dم]ِّنۡهُمۡ‌ۖ","وَقَالَ","[wٱ]لۡكَ[nـٰ]فِرُونَ","هَ[nـٰ]ذَا","سَ[nـٰ]حِ[fرٌ]","[fك]َذّ[pَا][qب]ٌ"],"Они удивились тому, что к ним явился предостерегающий увещеватель из них самих, и неверующие сказали: «Это - лживый колдун!",[250,2520,2530,3590,3600,6640,6650,8850,8860,9900,16150,17130,17140,19260,19270,20450,20460,22440,22450,24100],[30,2530,2540,3760,3770,6960,6970,9510,9520,10800,10810,11620,11630,13120,13130,13970,13980,15670,15680,16250]],[["أَجَعَلَ","[wٱ]لۡأَلِهَةَ","إِلَ[nـٰ][dهًا]","[dو][nٰ]حِدًا‌ۖ","إِ[gنّ]َ","هَ[nـٰ]ذَا","لَشَىۡءٌ","عُج[pَا][qب]ٌ"],"Неужели он обратил богов в Единственного Бога? Воистину, это - нечто удивительное!».",[450,1270,1280,2960,2970,4770,4780,6250,9650,10620,10630,11830,11840,13150,13160,14340],[30,780,790,2090,2100,2940,2950,5690,5700,7070,7080,7970,7980,8960,8970,11500]],[["وَ[wٱ][fنط]َلَقَ","[wٱ]لۡمَلَأُ","مِنۡهُمۡ","أَنِ","[wٱ]مۡشُو[sاۡ]","وَ[wٱ]صۡبِرُو[sاۡ]","عَلَ[uىٰٓ]","ءَالِهَتِكُمۡ‌ۖ","إِ[gنّ]َ","هَ[nـٰ]ذَا","لَش[dَىۡءٌ]","[dي]ُر[pَا][qد]ُ"],"Знатные люди из их числа удалились со словами: «Ступайте и терпите за ваших богов. Воистину, это - некий замысел (или нечто желанное).",[400,2180,2190,3250,3260,4450,4600,5050,5060,6010,6020,7420,7430,9070,9080,11100,14800,15780,15790,17060,17070,18830,18840,20000],[30,1950,1960,2780,2790,3640,3650,3990,4000,4710,4720,5640,5650,7420,7430,9340,9350,10810,10820,11750,11760,13620,13630,15900]],[["مَا","سَمِعۡنَا","بِهَ[nـٰ]ذَا","فِى","[wٱ]لۡمِلَّةِ","[wٱ]لۡأَخِرَةِ","إِنۡ","هَ[nـٰ]ذ[uَآ]","إِلَّا","[wٱ]خۡتِلَ[pـٰ][qق]ٌ"],"Мы не слышали об этом в последней религии. Это - не что иное, как вымысел.",[300,690,700,2150,2160,3520,3530,3850,3860,5250,5260,6980,6990,7510,7520,9680,9690,10460,10470,12010],[30,330,340,1440,1450,2470,2480,2750,2760,3820,3830,5100,5110,5470,5480,5990,6000,8330,8340,10580]],[["أَءُ[fنز]ِلَ","عَلَيۡهِ","[wٱ][lل]ذِّكۡرُ","م[iِنۢ]","[iب]َيۡنِنَا‌ۚ","بَلۡ","هُمۡ","فِى","شَ[dكٍّ]","[dم]ِّ[fن]","[fذ]ِكۡرِى‌ۖ","بَل","لَّ[gمّ]َا","يَذُوقُو[sاۡ]","عَذ[pَا][qب]ِ"],"Неужели среди нас Напоминание ниспослано только ему одному?». О нет! Они сомневаются в Моем Напоминании (Коране). О нет! Они еще не вкусили мучений.",[450,1980,1990,3050,3060,4190,4200,5150,5160,6600,11750,12270,12280,12810,12820,13470,13480,15180,15190,16120,16130,16550,21600,22140,22150,23420,23430,24840,24850,26110],[60,1950,1960,2880,2890,3700,3710,4900,4910,6520,6530,6880,6890,7270,7280,7670,7680,9280,9290,10110,10120,10920,10930,11430,11440,12920,12930,14020,14030,16370]],[["أَمۡ","عِ[fند]َهُمۡ","خَز[oَا]ٓئِنُ","رَحۡمَةِ","رَبِّكَ","[wٱ]لۡعَزِيزِ","[wٱ]لۡوَهّ[pَا][qب]ِ"],"Или же у них есть сокровищницы милости твоего Господа, Могущественного, Дарующего?",[250,590,600,2450,2460,4910,4920,6010,6020,7220,7230,8730,8740,10690],[70,360,370,2040,2050,4540,4550,5290,5300,6160,6170,7270,7280,8340]],[["أَمۡ","لَه[hُم]","[hم]ُّلۡكُ","[wٱ][lل]سَّمَ[nـٰ]و[nٰ]تِ","وَ[wٱ]لۡأَرۡضِ","وَمَا","بَيۡنَهُمَا‌ۖ","فَلۡيَرۡتَقُو[sاۡ]","فِى","[wٱ]لۡأَسۡبَ[pـٰ][qب]ِ"],"Или же им принадлежит власть над небесами, землей и тем, что между ними? Пусть же они поднимутся на небеса по путям (или веревкам).",[250,700,710,1980,1990,2670,2680,4820,4830,6190,6200,7040,7050,8950,13400,15410,15420,15790,15800,17650],[30,360,370,1610,1620,2150,2160,3660,3670,4670,4680,5250,5260,6480,6490,7940,7950,8230,8240,8980]],[["جُن[dدٌ]","[dم]َّا","هُنَالِكَ","مَهۡزُو[dمٌ]","[dم]ِّنَ","[wٱ]لۡأَحۡز[pَا][qب]ِ"],"Это войско будет разбито, подобно прежним соумышленникам.",[300,2230,2240,2730,2740,4290,4300,6450,6460,6870,6880,8820],[30,2270,2280,2560,2570,3660,3670,5700,5710,5960,5970,8490]],[["كَذَّبَتۡ","قَ[qبۡ]لَهُمۡ","قَوۡمُ","نُو[dحٍ]","[dو]َعَا[dدٌ]","[dو]َفِرۡعَوۡنُ","ذُو","[wٱ]لۡأَوۡت[pَا][qد]ِ"],"До них посланников сочли лжецами народ Нуха (Ноя), адиты и Фараон, владыка кольев,",[300,1530,1540,2860,2870,3820,3830,5330,5340,7090,7100,8730,8740,9070,9080,10770],[30,970,980,2040,2050,2640,2650,3480,3490,4810,4820,6690,6700,6890,6900,9520]],[["وَثَمُودُ","وَقَوۡمُ","لُو[dطٍ]","[dو]َأَصۡحَ[nـٰ]بُ","لۡــَٔيۡكَةِ‌ۚ","أُ[sوۡ]لَ[oـٰٓ]ئِكَ","[wٱ]لۡأَحۡز[pَا][qب]ُ"],"самудяне, народ Лута (Лота) и жители Айки. Это были соумышленники.",[400,1820,1830,3010,3020,4500,4510,6250,6260,7850,12850,15360,15370,17370],[30,1040,1050,1820,1830,3460,3470,4680,4690,6120,6130,8560,8570,11110]],[["إِ[fن]","[fك]ُلٌّ","إِلَّا","كَذَّبَ","[wٱ][lل]رُّسُلَ","فَحَقَّ","عِق[pَا][qب]ِ"],"Все они сочли лжецами посланников, и истинным было Мое наказание.",[300,1300,1310,2480,2490,3590,3600,4740,4750,5850,5860,7120,7130,8430],[30,1230,1240,2140,2150,2920,2930,3770,3780,4610,4620,5450,5460,8080]],[["وَمَا","يَ[fنظ]ُرُ","هَ[oـٰٓ]ؤُل[oَا]ٓءِ","إِلَّا","صَيۡحَ[dةً]","[dو][nٰ]حِدَ[dةً]","[dم]َّا","لَهَا","مِ[fن]","[fف]َو[pَا][qق]ٍ"],"Им нечего ждать, кроме одного лишь гласа, для которого нет возврата.",[200,960,970,4000,4010,6100,6110,7150,7160,9030,9040,10630,10640,11810,11820,12690,12700,13510,13520,14990],[40,630,640,2270,2280,6750,6760,7490,7500,8560,8570,10250,10260,11750,11760,12360,12370,13370,13380,13910]],[["وَقَالُو[sاۡ]","رَبَّنَا"