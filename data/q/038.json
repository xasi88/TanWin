1490,1500,2050,2060,2890,2900,3260,3270,4350,4360,7170]],[["إِذۡ","دَخَلُو[sاۡ]","عَلَىٰ","دَاوُ[nۥ]دَ","فَفَزِعَ","مِنۡهُمۡ‌ۖ","قَالُو[sاۡ]","لَا","تَخَفۡ‌ۖ","خَصۡمَانِ","بَغَىٰ","بَعۡضُنَا","عَلَىٰ","بَعۡ[fضٍ]","[fف]َ[wٱ]حۡك[Fُم]","[Fب]َيۡنَنَا","بِ[wٱ]لۡحَقِّ","وَلَا","تُشۡطِ[qطۡ]","وَ[wٱ]هۡدِن[uَآ]","إِلَىٰ","سَو[oَا]ٓءِ","[wٱ][lل]صِّر[pٰ][qط]ِ"],"Они вошли к Давуду (Давиду), и он испугался их. Они сказали: «Не бойся, мы - двое тяжущихся. Один из нас поступил несправедливо по отношению к другому. Рассуди же между нами по справедливости, не будь несправедлив и укажи нам на верный путь.",[550,850,860,2100,2110,2930,2940,4420,4430,5700,5710,6900,6910,8220,8230,8740,8750,9750,15700,17060,17070,17960,17970,19450,19460,20420,20430,22140,22150,23870,23880,25370,25380,26860,26870,27780,27790,29100,36990,39280,39290,40150,40160,42320,42330,43940],[30,390,400,1160,1170,1790,1800,2750,2760,3610,3620,4940,4950,5760,5770,6080,6090,7280,7290,8300,8310,8900,8910,9850,9860,10510,10520,12050,12060,13620,13630,14620,14630,15660,15670,16170,16180,17110,17120,17750,17760,19840,19850,22050,22060,24630]],[["إِ[gنّ]َ","هَ[nـٰ]ذ[uَآ]","أَخِى","لَهُ[nۥ]","تِسۡ[dعٌ]","[dو]َتِسۡعُونَ","نَعۡجَ[dةً]","[dو]َلِىَ","نَعۡجَ[dةٌ]","[dو][nٰ]حِدَ[fةٌ]","[fف]َقَالَ","أَكۡفِلۡنِيهَا","وَعَزَّنِى","فِى","[wٱ]لۡخِط[pَا][qب]ِ"],"Это - мой брат. У него есть девяносто девять овец, а у меня - всего одна овца. Он сказал: «Отдай ее мне!» - и одолел меня на словах».",[650,1690,1700,3780,3790,4660,4670,5480,5490,7120,7130,8680,8690,10770,10780,11590,11600,13520,13530,14950,25860,27090,27100,29540,29550,31290,31300,31650,31660,33210],[30,1200,1210,3650,3660,4290,4300,4840,4850,5720,5730,7530,7540,8510,8520,9670,9680,10510,10520,13080,13090,14000,14010,18830,18840,20030,20040,20280,20290,22700]],[["قَالَ","لَقَ[qدۡ]","ظَلَمَكَ","بِسُؤَالِ","نَعۡجَتِكَ","إِلَىٰ","نِعَاجِه[nِۦ]‌ۖ","وَإِ[gنّ]َ","كَثِي[dرًا]","[dم]ِّنَ","[wٱ]لۡخُلَط[oَا]ٓءِ","لَيَ[qبۡ]غِى","بَعۡضُهُمۡ","عَلَىٰ","بَعۡضٍ","إِلَّا","[wٱ]لَّذِينَ","ء