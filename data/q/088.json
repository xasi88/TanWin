{"id":88,"v":[[["هَلۡ","أَتَ[nـٰ]كَ","حَدِيثُ","[wٱ]لۡغَ[nـٰ]شِيَةِ"],"Дошел ли до тебя рассказ о Покрывающем (Дне воскресения)?",[400,870,880,2050,2060,3350,3360,5300],[50,390,400,1140,1150,2010,2020,3230]],[["وُجُو[dهٌ]","[dي]َوۡمَئِذٍ","خَ[nـٰ]شِعَةٌ"],"Одни лица в тот день будут унижены,",[250,2110,2120,3770,3780,5400],[30,1980,1990,3140,3150,4270]],[["عَامِلَ[dةٌ]","[dن]َّاصِبَةٌ"],"изнурены и утомлены.",[450,2530,2540,3880],[30,2270,2280,3130]],[["تَصۡلَىٰ","نَارًا","حَامِيَةً"],"Они войдут в Огонь жаркий.",[400,1570,1580,2760,2770,4290],[30,820,830,1540,1550,2630]],[["تُسۡقَىٰ","مِنۡ","عَيۡنٍ","ءَانِيَةٍ"],"Их будут поить из источника кипящего",[450,1700,1710,2200,2210,3520,3530,5230],[30,810,820,1170,1180,2120,2130,3010]],[["لَّيۡسَ","لَهُمۡ","طَعَامٌ","إِلَّا","مِ[fن]","[fض]َر[pِي]عٍ"],"и кормить только ядовитыми колючками,",[550,1400,1410,2200,2210,3950,3960,5290,5300,6190,6200,7590],[30,610,620,1150,1160,2250,2260,3150,3160,4440,4450,6680]],[["لَّا","يُسۡمِنُ","وَلَا","يُغۡنِى","مِ[fن]","[fج][pُو]عٍ"],"от которых не поправляются и которые не утоляют голода.",[600,1230,1240,2570,2580,3490,3500,4880,4890,5930,5940,6960],[40,360,370,1210,1220,1760,1770,2710,2720,3850,3860,5700]],[["وُجُو[dهٌ]","[dي]َوۡمَئِ[dذٍ]","[dن]َّاعِمَةٌ"],"Другие же лица в тот день будут радостны.",[300,2070,2080,3770,3780,5810],[30,1940,1950,3710,3720,4820]],[["لِّسَعۡيِهَا","رَاضِيَةٌ"],"Они будут довольны своими стараниями",[400,2210,2220,4030],[30,1280,1290,2270]],[["فِى","جَ[gنّ]َةٍ","عَالِيَةٍ"],"в Вышних садах.",[450,1050,1060,2900,2910,4700],[30,350,360,2150,2160,3160]],[["لَّا","تَسۡمَعُ","فِيهَا","لَ[nـٰ]غِيَةً"],"Они не услышат там словоблудия.",[450,990,1000,2370,2380,3910,3920,5600],[30,380,390,1270,1280,2200,2210,3190]],[["فِيهَا","عَيۡ[fنٌ]","[fج]َارِيَةٌ"],"Там есть источник текущий.",[500,1700,1710,3310,3320,5030],[30,730,740,2460,2470,3450]],[["فِيهَا","سُرُ[dرٌ]","[dم]َّرۡفُوعَةٌ"],"Там воздвигнуты ложа,",[550,1750,1760,3380,3390,5460],[30,840,850,2640,2650,3820]],[["وَأَكۡوَا[dبٌ]","[dم]َّوۡضُوعَةٌ"],"расставлены чаши,",[350,2930,2940,4920],[30,2370,2380,3610]],[["وَنَمَارِقُ","مَصۡفُوفَةٌ"],"разложены подушки,",[400,2310,2320,4480],[30,1320,1330,2520]],[["وَزَرَابِىُّ","مَ[qبۡ]ثُوثَةٌ"],"и разостланы ковры.",[450,2700,2710,4760],[30,1490,1500,2770]],[["أَفَلَا","يَ[fنظ]ُرُونَ","إِلَى","[wٱ]لۡإِبِلِ","كَيۡفَ","خُلِقَتۡ"],"Неужели они не видят, как созданы верблюды,",[450,1610,1620,3840,3850,4400,4410,5660,5670,6680,6690,8230],[30,790,800,2720,2730,3080,3090,3950,3960,4550,4560,5480]],[["وَإِلَى","[wٱ][lل]سَّم[oَا]ٓءِ","كَيۡفَ","رُفِعَتۡ"],"как вознесено небо,",[450,1170,1180,3750,3760,4720,4730,6240],[30,540,550,3120,3130,3720,3730,4600]],[["وَإِلَى","[wٱ]لۡجِبَالِ","كَيۡفَ","نُصِبَتۡ"],"как водружены горы,",[500,1120,1130,2690,2700,3710,3720,5070],[30,550,560,1620,1630,2290,2300,3110]],[["وَإِلَى","[wٱ]لۡأَرۡضِ","كَيۡفَ","سُطِحَتۡ"],"как распростерта земля?",[350,990,1000,2230,2240,3260,3270,4640],[30,570,580,1460,1470,2010,2020,2910]],[["فَذَكِّرۡ","إِ[gنّ]َم[uَآ]","أَ[fنت]َ","مُذَكِّرٌ"],"Наставляй же, ведь ты - наставник,",[500,1900,2150,4670,4680,6080,6090,7700],[30,910,920,3980,3990,5200,5210,6180]],[["لَّسۡتَ","عَلَيۡه[Fِم]","[Fب]ِمُصَيۡطِرٍ"],"и ты не властен над ними.",[300,1150,1160,3250,3260,5170],[30,590,600,2210,2220,3420]],[["إِلَّا","مَ[fن]","[fت]َوَلَّىٰ","وَكَفَرَ"],"А тех, кто отвернется и не уверует,",[300,1600,1610,2530,2540,4320,4330,5810],[30,800,810,1840,1850,3000,3010,3790]],[["فَيُعَذِّبُهُ","[wٱ]للَّهُ","[wٱ]لۡعَذَابَ","[wٱ]لۡأَكۡبَرَ"],"Аллах подвергнет величайшим мучениям.",[550,2660,2670,4010,4020,5580,5590,7390],[30,1410,1420,2280,2290,3350,3360,4400]],[["إِ[gنّ]َ","إِلَيۡن[uَآ]","إِيَابَهُمۡ"],"К Нам они вернутся,",[300,1390,1400,4030,4040,5910],[30,1340,1350,2050,2060,5120]],[["ثُ[gمّ]َ","إِ[gنّ]َ","عَلَيۡنَا","حِسَابَهُم"],"и затем Мы потребуем у них отчета.",[700,1940,1950,3130,3140,4770,4780,6790],[30,1340,1350,2690,2700,3940,3950,5550]]]}