{"id":80,"v":[[["عَبَسَ","وَتَوَلَّىٰٓ"],"Он нахмурился и отвернулся,",[300,1130,1140,3290],[30,700,710,2320]],[["أَ[fن]","[fج][oَا]ٓءَهُ","[wٱ]لۡأَعۡمَىٰ"],"потому что к нему подошел слепой.",[250,1170,1180,3510,3520,5340],[30,1260,1270,3490,3500,4620]],[["وَمَا","يُ[qدۡ]رِيكَ","لَعَلَّهُ[nۥ]","يَزَّكَّىٰٓ"],"Откуда тебе знать? Возможно, он бы очистился",[350,1050,1060,2520,2530,4310,4320,6610],[30,640,650,1700,1710,2970,2980,4630]],[["أَوۡ","يَذَّكَّرُ","فَتَ[fنف]َعَهُ","[wٱ][lل]ذِّكۡرَىٰٓ"],"или помянул бы наставление, и поминание принесло бы ему пользу.",[250,680,690,2600,2610,4940,4950,6760],[30,400,410,1610,1620,3510,3520,4800]],[["أَ[gمّ]َا","مَنِ","[wٱ]سۡتَغۡنَىٰ"],"Тому, кто решил, что он ни в чем не нуждается,",[250,1900,1910,2360,2370,4210],[30,1420,1430,1760,1770,3090]],[["فَأَ[fنت]َ","لَهُ[nۥ]","تَصَدَّىٰ"],"ты уделяешь внимание,",[40,1700,1710,2540,2550,4570],[30,1470,1480,2060,2070,3490]],[["وَمَا","عَلَيۡكَ","أَلَّا","يَزَّكَّىٰ"],"Что же будет тебе, если он не очистится?",[350,1080,1090,2230,2240,3450,3460,5790],[30,540,550,1510,1520,2360,2370,3910]],[["وَأَ[gمّ]َا","مَ[fن]","[fج][oَا]ٓءَكَ","يَسۡعَىٰ"],"А того, кто приходит к тебе со рвением",[300,2100,2110,3280,3290,5580,5590,7110],[30,1700,1710,2860,2870,5050,5060,6180]],[["وَهُوَ","يَخۡشَىٰ"],"и страшится Аллаха,",[350,1160,1170,2850],[30,610,620,1820]],[["فَأَ[fنت]َ","عَنۡهُ","تَلَهَّىٰ"],"ты оставляешь без внимания.",[350,1790,1800,2690,2700,4730],[30,1250,1260,1910,1920,3340]],[["كَلّ[uَآ]","إِ[gنّ]َهَا","تَذۡكِرَةٌ"],"Но нет! Это есть Назидание,",[300,2670,2680,4490,4500,5880],[40,2030,2040,4180,4190,5200]],[["فَمَ[fن]","[fش][oَا]ٓءَ","ذَكَرَهُۥ"],"и пусть помянет его всякий желающий.",[400,1410,1420,3600,3610,4680],[30,1190,1200,3260,3270,3970]],[["فِى","صُحُ[dفٍ]","[dم]ُّكَرَّمَةٍ"],"Оно записано в свитках почитаемых,",[450,900,910,2700,2710,4300],[30,350,360,1980,1990,2910]],[["مَّرۡفُوعَ[dةٍ]","[dم]ُّطَهَّرَةِۭ"],"вознесенных и очищенных,",[300,2830,2840,4370],[30,2330,2340,3360]],[["بِأَيۡدِى","سَفَرَةٍ"],"в руках посланцев",[300,1660,1670,3110],[30,980,990,1790]],[["كِرَا[iمِۭ]","[iب]َرَرَةٍ"],"благородных и покорных.",[250,2090,2100,3050],[30,1070,1080,2874]],[["قُتِلَ","[wٱ]لۡإِ[fنس]َ[nـٰ]نُ","م[uَآ]","أَكۡفَرَهُۥ"],"Да сгинет человек! Как же он неблагодарен!",[350,1040,1050,3610,3620,5230,5240,6470],[30,560,570,2750,2760,4440,4450,5370]],[["مِنۡ","أَىِّ","شَىۡءٍ","خَلَقَهُۥ"],"Из чего Он сотворил его?",[350,910,920,1780,1790,3010,3020,4150],[50,360,370,1020,1030,1890,1900,2740]],[["م[dِن]","[dن]ُّ[qطۡ]فَةٍ","خَلَقَهُ[nۥ]","فَقَدَّرَهُۥ"],"Он сотворил его из капли и соразмерил (или предопределил стадии его развития),",[0,1420,1430,2770,2780,4380,4390,6030],[40,1480,1490,2390,2400,3500,3510,4820]],[["ثُ[gمّ]َ","[wٱ][lل]سَّبِيلَ","يَسَّرَهُۥ"],"потом облегчил ему путь,",[400,1490,1500,3080,3090,4380],[30,1340,1350,2440,2450,3480]],[["ثُ[gمّ]َ","أَمَاتَهُ[nۥ]","فَأَ[qقۡ]بَرَهُۥ"],"потом умертвил его и поместил в могилу.",[400,1440,1450,3250,3260,4950],[30,1230,1240,2580,2590,3860]],[["ثُ[gمّ]َ","إِذَا","ش[oَا]ٓءَ","أَ[fنش]َرَهُۥ"],"Потом, когда пожелает, Он воскресит его.",[400,1550,1560,2620,2630,4840,4850,6750],[30,1410,1420,2000,2010,3970,3980,5760]],[["كَلَّا","لَ[gمّ]َا","يَ[qقۡ]ضِ","م[uَآ]","أَمَرَهُۥ"],"Но нет! Он не выполняет того, что Он приказал ему.",[500,1730,1740,3330,3340,4330,4340,6030,6040,7090],[30,840,850,2350,2360,3140,3150,5030,5040,5750]],[["فَلۡيَ[fنظ]ُرِ","[wٱ]لۡإِ[fنس]َ[nـٰ]نُ","إِلَىٰ","طَعَامِهِۦٓ"],"Пусть посмотрит человек на свое пропитание!",[400,2430,2440,4730,4740,5600,5610,7100],[30,1950,1960,3870,3880,4470,4480,5560]],[["أَ[gنّ]َا","صَبَ[qبۡ]نَا","[wٱ]لۡم[oَا]ٓءَ","صَبًّا"],"Мы проливаем обильные ливни,",[350,1880,1890,3120,3130,5320,5330,6640],[30,1610,1620,2510,2520,4800,4810,5910]],[["ثُ[gمّ]َ","شَقَ[qقۡ]نَا","[wٱ]لۡأَرۡضَ","شَقًّا"],"затем рассекаем землю трещинами",[400,1520,1530,2760,2770,4050,4060,5020],[30,1600,1610,2500,2510,3360,3370,4390]],[["فَأَ[iنۢب]َتۡنَا","فِيهَا","حَبًّا"],"и взращиваем на ней з