{"id":86,"v":[[["وَ[wٱ][lل]سَّم[oَا]ٓءِ","وَ[wٱ][lل]طَّارِ[qق]ِ"],"Клянусь небом и ночным путником!",[300,3310,3320,4950],[30,3170,3180,4400],[591,2,2,2],30],[["وَم[uَآ]","أَ[qدۡ]رَ[nٮٰ]كَ","مَا","[wٱ][lل]طَّارِ[qق]ُ"],"Откуда ты мог знать, что такое ночной путник?",[150,1920,1930,3570,3580,3800,3810,5460],[30,2080,2090,3180,3190,3350,3360,4410],[591,2,2,2,2,2],30],[["ٱ[lل][gنّ]َ[qجۡ]مُ","[wٱ][lل]ثَّاقِ[qب]ُ"],"Это - звезда пронизывающая небеса своим светом.",[350,2140,2150,3690],[30,1960,1970,3060],[591,2,2,2],30],[["إِ[fن]","[fك]ُلُّ","نَفۡ[Dسٍ]","[Dل]َّ[gمّ]َا","عَلَيۡهَا","حَافِظٌ"],"Нет души, при которой не было бы хранителя.",[350,1300,1310,2350,2360,3330,3340,5140,5150,6830,6840,8170],[30,1010,1020,1750,1760,2440,2450,4270,4280,5380,5390,6320],[591,2,2,3,3,3,3,3],30],[["فَلۡيَ[fنظ]ُرِ","[wٱ]لۡإِ[fنس]َ[nـٰ]نُ","مِ[gمّ]َ","خُلِ[qق]َ"],"Пусть посмотрит человек, из чего он создан.",[300,2270,2280,4690,4700,5810,5820,6640],[30,2090,2100,4190,4200,5600,5610,6270],[591,3,3,3,3,3],30],[["خُلِقَ","م[dِن]","[dم]ّ[oَا]ٓ[fءٍ]","[fد]َافِ[qق]ٍ"],"Он создан из изливающейся жидкости,",[250,1090,1100,2060,2070,4660,4670,5760],[30,660,670,1680,1690,4770,4780,5620],[591,3,3,3,4,4],30],[["يَخۡرُجُ","م[iِنۢ]","[iب]َيۡنِ","[wٱ][lل]صُّلۡبِ","وَ[wٱ][lل]تَّر[oَا]ٓئِ[qب]ِ"],"которая выходит между чреслами и грудными костями.",[350,1520,1530,2360,2370,3300,3310,4580,4590,7430],[50,870,880,2020,2030,2610,2620,3550,3560,6710],[591,4,4,4,4,4,4],30],[["إِ[gنّ]َهُ[nۥ]","عَلَىٰ","رَ[qجۡ]عِه[nِۦ]","لَقَادِرٌ"],"Воистину, Он способен вернуть его.",[300,2050,2060,3060,3070,4670,4680,6220],[30,1790,1800,2550,2560,3660,3670,4770],[591,4,4,4,4,4],30],[["يَوۡمَ","تُ[qبۡ]لَى","[wٱ][lل]سَّر[oَا]ٓئِرُ"],"В тот день будут испытаны (или раскроются) тайны,",[300,1110,1120,1990,2000,4730],[30,590,600,1240,1250,3900],[591,5,5,5,5],30],[["فَمَا","لَهُ[nۥ]","مِ[fن]","[fق]ُوَّ[dةٍ]","[dو]َلَا","نَاصِرٍ"],"и тогда не будет у него ни силы, ни помощника.",[300,1090,1100,2090,2100,3100,3110,5180,5190,6230,6240,7