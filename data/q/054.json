{"id":54,"v":[[["ٱ[qقۡ]تَرَبَتِ","[wٱ][lل]سَّاعَةُ","وَ[wٱ][fنش]َقَّ","[wٱ]لۡقَمَرُ"],"Приблизился Час, и раскололся месяц.",[400,1810,1820,3410,3420,5370,5380,6760],[70,1310,1320,2510,2520,4380,4390,5270],[528,11,11,11,11,11],27],[["وَإ[dِن]","[dي]َرَوۡ[sا۟]","ءَايَ[dةً]","[dي]ُعۡرِضُو[sا۟]","وَيَقُولُو[sا۟]","سِحۡ[dرٌ]","[dم]ُّسۡتَمِرٌّ"],"Когда они видят знамение, то отворачиваются и говорят: «Это - преходящее (или крепкое; или лживое) колдовство!».",[300,1280,1290,2060,2070,3890,3900,5370,5380,7170,7180,8890,8900,10320],[30,1370,1380,1770,1780,3430,3440,4580,4590,5880,5890,7960,7970,9080],[528,11,11,11,11,12,12,12,12],27],[["وَكَذَّبُو[sا۟]","وَ[wٱ]تَّبَع[oُوٓ][sا۟]","أَهۡو[oَا]ٓءَهُمۡ‌ۚ","وَكُلُّ","أَمۡ[dرٍ]","[dم]ُّسۡتَقِرٌّ"],"Они сочли лжецами посланников и потакали своим желаниям, но каждый поступок утвердится (творения получат вознаграждение за добро и наказание за зло).",[400,1990,2000,4560,4570,7500,11600,12580,12590,14260,14270,15830],[30,1330,1340,3810,3820,7290,7300,8170,8180,10090,10100,11070],[528,12,12,12,13,13,13,13],27],[["وَلَقَ[qدۡ]","ج[oَا]ٓءَه[hُم]","[hم]ِّنَ","[wٱ]لۡأَ[iنۢب][oَا]ٓءِ","مَا","فِيهِ","مُزۡدَجَرٌ"],"До них уже дошли известия, которые удерживали от неверия.",[200,1160,1170,4050,4060,4470,4480,7730,7740,8260,8270,9210,9220,10890],[30,800,810,3900,3910,4200,4210,8380,8390,8740,8750,9490,9500,10510],[528,13,13,13,13,14,14,14,14],27],[["حِكۡمَ[iةُۢ]","[iب]َ[nـٰ]لِغَ[fةٌ‌ۖ]","[fف]َمَا","تُغۡنِ","[wٱ][lل][gنّ]ُذُرُ"],"Это является совершенной мудростью, но какую пользу приносят предостережения (или предостережения не принесли им никакой пользы)?",[350,2830,2840,3800,8050,8710,8720,10230,10240,11230],[70,2180,2190,4450,4460,5170,5180,5930,5940,7240],[528,14,14,14,14,14,15],27],[["فَتَوَلَّ","عَنۡهُمۡ‌ۘ","يَوۡمَ","يَ[qدۡ]عُ","[wٱ][lل]دَّاعِ","إِلَىٰ","ش[dَىۡءٍ]","[dن]ُّكُرٍ"],"Отвернись же от них. В тот день, когда глашатай призовет к неприятной вещи,",[30,1520,1530,2800,8650,9430,9440,10230,10240,11610,11620,12470,12480,14160,14170,15190],[30,950,960,2570,2580,3150,3160,3810,3820,4770,4780,5310,5320,6950,6960,7490],[528,15,15,15,15,15,15,15,15,15],27],[["خُشَّعًا","أَ[qبۡ]صَ[nـٰ]رُهُمۡ","يَخۡرُجُونَ","مِنَ","[wٱ]لۡأَ[qجۡ]دَاثِ","كَأَ[gنّ]َهُمۡ","جَرَا[dدٌ]","[dم]ُّ[fنت]َشِرٌ"],"они с униженными взорами выйдут из могил, словно рассеянная саранча.",[450,1730,1740,3790,3800,5590,5600,6090,6100,7950,7960,9930,9940,11940,11950,13730],[30,1060,1070,2570,2580,3970,3980,4330,4340,5660,5670,7790,7800,11060,11070,11690],[529,1,1,1,1,1,1,1,1,1],27],[["مُّهۡطِعِينَ","إِلَى","[wٱ][lل]دَّاعِ‌ۖ","يَقُولُ","[wٱ]لۡكَ[nـٰ]فِرُونَ","هَ[nـٰ]ذَا","يَوۡمٌ","عَسِرٌ"],"Они устремятся к глашатаю, и неверующие скажут: «Это - Тяжкий день!».",[250,1670,1680,2220,2230,3750,7450,8480,8490,10490,10500,11740,11750,12830,12840,13880],[30,1230,1240,1650,1660,4520,4530,5390,5400,6930,6940,7850,7860,8740,8750,9550],[529,2,2,2,2,2,2,2,2,2],27],[["۞كَذَّبَتۡ","قَ[qبۡ]لَهُمۡ","قَوۡمُ","نُو[fحٍ]","[fف]َكَذَّبُو[sا۟]","عَ[qبۡ]دَنَا","وَقَالُو[sا۟]","مَ[qجۡ]نُو[dنٌ]","[dو]َ[wٱ]زۡدُجِرَ"],"До них счел лжецами посланников народ Нуха (Ноя). Они сочли лжецом Нашего раба и сказали: «Он - одержимый!». Они ругали его и угрожали ему.",[400,1490,1500,2910,2920,3830,3840,5260,5270,6980,6990,8520,8530,10190,10200,12320,12330,13670],[30,970,980,2080,2090,2740,2750,4180,4190,5500,5510,6600,6610,7810,7820,9070,9080,10760],[529,2,3,3,3,3,3,3,3,3,3],27],[["فَدَعَا","رَبَّهُ[uۥٓ]","أَ[gنّ]ِى","مَغۡلُو[fبٌ]","[fف]َ[wٱ][fنت]َصِرۡ"],"Тогда он воззвал к своему Господу: «Меня одолели. Помоги же мне!».",[450,1430,1440,2810,2820,5510,5520,7800,7810,9890],[30,780,790,3320,3330,4860,4870,6980,6990,9050],[529,3,4,4,4,4,4],27],[["فَفَتَحۡن[uَآ]","أَ[qبۡ]و[nٰ]بَ","[wٱ][lل]سَّم[oَا]ٓءِ","بِم[oَا]ٓ[dءٍ]","[dم]ُّنۡهَمِرٍ"],"Мы открыли врата неба, откуда стала изливаться вода,",[500,3010,3020,4500,4510,6690,6700,9330,9340,10620],[30,2930,2940,3970,3980,6580,6590,10830,10840,11680],[529,4,4,4,4,4,5],27],[["وَفَجَّرۡنَا","[wٱ]لۡأَرۡضَ","عُيُو[fنًا]","[fف]َ[wٱ]لۡتَقَى","[w