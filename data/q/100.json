{"id":100,"v":[[["وَ[wٱ]لۡعَ[nـٰ]دِيَ[nـٰ]تِ","ضَ[qبۡ]حًا"],"Клянусь скачущими, запыхаясь!",[150,2500,2510,3730],[100,1830,1840,2800]],[["فَ[wٱ]لۡمُورِيَ[nـٰ]تِ","قَ[qدۡ]حًا"],"Клянусь высекающими искры копытами!",[400,2770,2780,3620],[40,1720,1730,2720]],[["فَ[wٱ]لۡمُغِير[nٰ]تِ","صُ[qبۡ]حًا"],"Клянусь нападающими на заре!",[350,2650,2660,3960],[30,1620,1630,2650]],[["فَأَثَرۡنَ","بِه[nِۦ]","نَ[qقۡ]عًا"],"Тем самым они поднимают столб пыли",[400,1710,1720,2670,2680,3790],[30,1020,1030,1710,1720,2660]],[["فَوَسَ[qطۡ]نَ","بِه[nِۦ]","جَمۡعًا"],"и врываются с ним (со столбом пыли или с всадником) в гущу.",[350,1650,1660,2650,2660,3900],[40,1030,1040,1700,1710,2670]],[["إِ[gنّ]َ","[wٱ]لۡإِ[fنس]َ[nـٰ]نَ","لِرَبِّه[nِۦ]","لَكَن[pُو][qد]ٌ"],"Воистину, человек неблагодарен своему Господу,",[300,1400,1410,3790,3800,5770,5780,7310],[30,1160,1170,3420,3430,4690,4700,7210]],[["وَإِ[gنّ]َهُ[nۥ]","عَلَىٰ","ذ[nٰ]لِكَ","لَشَه[pِي][qد]ٌ"],"и он сам является тому свидетелем.",[150,1930,1940,2830,2840,4150,4160,5740],[30,1860,1870,2560,2570,3490,3500,6200]],[["وَإِ[gنّ]َهُ[nۥ]","لِحُبِّ","[wٱ]لۡخَيۡرِ","لَشَد[pِي][qد]ٌ"],"Воистину, он страстно любит блага.",[250,2090,2100,3280,3290,4540,4550,6250],[80,2080,2090,2940,2950,3800,3810,6620]],[["۞أَفَلَا","يَعۡلَمُ","إِذَا","بُعۡثِرَ","مَا","فِى","[wٱ]لۡقُب[pُو]رِ"],"Неужели он не знает, что, когда будет опрокинуто то, что в могилах,",[200,1290,1300,2480,2490,3450,3460,4730,4740,5260,5270,5640,5650,7410],[100,870,880,1780,1790,2450,2460,3360,3370,3720,3730,3940,3950,6710]],[["وَحُصِّلَ","مَا","فِى","[wٱ][lل]صُّد[pُو]رِ"],"и когда обнаружится то, что в груди,",[150,1520,1530,2130,2140,2390,2400,4310],[30,1080,1090,1470,1480,1680,1690,4440]],[["إِ[gنّ]َ","رَبَّه[Fُم]","[Fب]ِهِمۡ","يَوۡمَئِ[Dذٍ]","[Dل]َّخَب[pِي]رُۢ"],"в тот день Господь их будет осведомлен о них?",[30,1150,1160,3050,3060,3930,3940,5570,5580,7500],[30,1360,1370,3180,3190,3880,3890,5130,5140,8730]]]}