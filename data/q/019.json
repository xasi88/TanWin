60,3870,4730,4740,6690,6700,7630],[30,1410,1420,2690,2700,3350,3360,5000,5010,6260]],[["إِ[gنّ]َ","[wٱ]لَّذِينَ","ءَامَنُو[sاۡ]","وَعَمِلُو[sاۡ]","[wٱ][lل]صَّ[nـٰ]لِحَ[nـٰ]تِ","سَيَ[qجۡ]عَلُ","لَهُمُ","[wٱ][lل]رَّحۡمَ[nـٰ]نُ","وُدًّا"],"Тех, которые уверовали и совершали праведные деяния, Милостивый одарит любовью.",[300,1550,1560,3080,3090,4750,4760,5910,5920,8110,8120,9680,9690,10530,10540,12510,12520,13840],[30,1220,1230,2370,2380,3640,3650,4450,4460,6130,6140,7310,7320,7950,7960,9200,9210,10410]],[["فَإِ[gنّ]َمَا","يَسَّرۡنَ[nـٰ]هُ","بِلِسَانِكَ","لِتُبَشِّرَ","بِهِ","[wٱ]لۡمُتَّقِينَ","وَتُ[fنذ]ِرَ","بِه[nِۦ]","قَوۡ[Dمًا]","[Dل]ُّدًّا"],"Мы облегчили его (Коран) на твоем языке для того, чтобы ты обрадовал им богобоязненных людей и предостерег им злостных спорщиков.",[400,2460,2470,4700,4710,6560,6570,8330,8340,8940,8950,11300,18580,20430,20440,21360,21370,22330,22340,23930],[30,1720,1730,3330,3340,4690,4700,6120,6130,6600,6610,8150,8160,10100,10110,10780,10790,11330,11340,12730]],[["وَكَمۡ","أَهۡلَكۡنَا","قَ[qبۡ]لَه[hُم]","[hم]ِّ[fن]","[fق]َرۡنٍ","هَلۡ","تُحِسُّ","مِنۡه[hُم]","[hم]ِّنۡ","أَحَدٍ","أَوۡ","تَسۡمَعُ","لَهُمۡ","رِكۡزَۢا"],"Сколько поколений до них Мы подвергли гибели! Разве ты ощущаешь присутствие кого-нибудь из них или слышишь их шепот?",[350,1110,1120,2950,2960,6030,6040,6050,6060,6900,11850,12260,12270,13490,13500,15180,15190,15660,15670,16880,16890,17420,17430,18770,18780,19680,19690,20850],[50,730,740,2020,2030,3940,3950,4810,4820,5690,5700,6170,6180,7130,7140,8830,8840,9180,9190,10130,10140,10570,10580,11580,11590,12330,12340,13530]]]}