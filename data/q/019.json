{"id":19,"v":[[["[xكٓ]هي[xعٓصٓ]"],"Каф. Ха. Йа. Айн. Сад.",[0,13530],[160,12320]],[["ذِكۡرُ","رَحۡمَتِ","رَبِّكَ","عَ[qبۡ]دَهُ[nۥ]","زَكَرِيَّآ"],"Это является напоминанием о милости твоего Господа, оказанной Его рабу Закарии (Захарии).",[400,1110,1120,2140,2150,3360,3370,4920,4930,6910],[180,740,750,1540,1550,2410,2420,3520,3530,5030]],[["إِذۡ","نَادَىٰ","رَبَّهُ[nۥ]","نِد[oَا]ٓءً","خَفِيًّا"],"Вот он воззвал к своему Господу в тайне",[300,610,620,2150,2160,3790,3800,6650,6660,7960],[40,450,460,1260,1270,2450,2460,5120,5130,6420]],[["قَالَ","رَبِّ","إِ[gنّ]ِى","وَهَنَ","[wٱ]لۡعَظۡمُ","مِ[gنّ]ِى","وَ[wٱ]شۡتَعَلَ","[wٱ][lل]رَّأۡسُ","شَيۡ[dبًا]","[dو]َلَمۡ","أَك[iُنۢ]","[iب]ِدُع[oَا]ٓئِكَ","رَبِّ","شَقِيًّا"],"и сказал: «Господи! Воистину, кости мои ослабели, а седина уже распространилась по моей голове. А ведь раньше благодаря молитвам к Тебе, Господи, я не был несчастен.",[350,1090,1100,2120,2130,3820,3830,4680,4690,5930,5940,7600,7610,9020,9030,10430,10440,12050,20000,20860,20870,22400,22410,25400,25410,26410,26420,27710],[30,570,580,1280,1290,2810,2820,3440,3450,4330,4340,5940,5950,6900,6910,7830,7840,8520,8530,9880,9890,11110,11120,14020,14030,14670,14680,15970]],[["وَإِ[gنّ]ِى","خِفۡتُ","[wٱ]لۡمَو[nٰ]لِىَ","م[dِن]","[dو]َر[oَا]ٓءِى","وَكَانَتِ","[wٱ]مۡرَأَتِى","عَاقِ[fرًا]","[fف]َهَ[qبۡ]","لِى","م[Dِن]","[Dل]َّدُ[fنك]َ","وَلِيًّا"],"Я опасаюсь того, что натворят мои родственники после меня, потому что жена моя бесплодна. Даруй же мне от Тебя наследника,",[250,2100,2110,3050,3060,5000,5010,6030,6040,8630,8640,10290,10300,12010,12020,13800,22920,23910,23920,24550,24560,24910,24920,26780,26790,28310],[50,1640,1650,2320,2330,3670,3680,4760,4770,7350,7360,8460,8470,9550,9560,11240,11250,11920,11930,12420,12430,12650,12660,14380,14390,15620]],[["يَرِثُنِى","وَيَرِثُ","مِنۡ","ءَالِ","يَعۡقُوبَ‌ۖ","وَ[wٱ][qجۡ]عَلۡهُ","رَبِّ","رَضِيًّا"],"который наследует мне и семейству Йакуба (Иакова). И сделай его, Господи, угодником».",[450,1990,2000,3170,3180,3830,3840,4820,4830,6600,10550,12010,12020,12850,12860,14160],[160,1280,1290,2180,2190,2610,2620,3300,3310,4380,4390,5530,5540,6140,6150,7420]],[["يَ[nـٰ]زَكَرِيّ[uَآ]","إِ[gنّ]َا","نُبَشِّرُكَ","بِغُلَ[nـٰ]مٍ","[wٱ]سۡمُهُ[nۥ]","يَحۡيَىٰ","لَمۡ","نَ[qجۡ]عَل","لَّهُ[nۥ]","مِ[fن]","[fق]َ[qبۡ]لُ","سَمِيًّا"],"О Закария (Захария)! Воистину, Мы радуем тебя вестью о мальчике, имя которому Йахья (Иоанн). Мы не создавали прежде никого с таким именем (или никого подобного ему).",[300,4230,4240,6030,6040,7880,7890,9600,9610,11100,11110,12650,20160,20660,20670,21630,21640,23000,23010,24240,24250,25090,25100,26410],[110,3260,3270,4610,4620,5930,5940,7170,7180,8250,8260,9160,9170,9550,9560,10470,10480,11140,11150,12070,12080,12770,12780,13240]],[["قَالَ","رَبِّ","أَ[gنّ]َىٰ","يَكُونُ","لِى","غُلَ[nـٰ][dمٌ]","[dو]َكَانَتِ","[wٱ]مۡرَأَتِى","عَاقِ[dرًا]","[dو]َقَ[qدۡ]","بَلَغۡتُ","مِنَ","[wٱ]لۡكِبَرِ","عِتِيًّا"],"Он сказал: «Господи! Как может быть у меня мальчик, если моя жена бесплодна, а я уже достиг дряхлого возраста?».",[350,1010,1020,2090,2100,3750,3760,5110,5120,5690,5700,7680,7690,9250,9260,10920,10930,12850,25190,26020,26030,27310,27320,27870,27880,29090,29100,30360],[40,710,720,1370,1380,2750,2760,3750,3760,4130,4140,5740,5750,6870,6880,7920,7930,8820,8830,10060,10070,10970,10980,11370,11380,12230,12240,13530]],[["قَالَ","كَذ[nٰ]لِكَ","قَالَ","رَبُّكَ","هُوَ","عَلَىَّ","هَيِّ[dنٌ]","[dو]َقَ[qدۡ]","خَلَ[qقۡ]تُكَ","مِ[fن]","[fق]َ[qبۡ]لُ","وَلَمۡ","تَكُ","شَيۡــًٔا"],"Он сказал: «Все так и будет! Господь твой сказал: «Это для Меня легко, ведь прежде Я сотворил тебя самого, хотя тебя вообще не было»».",[350,1130,1140,2820,2830,3800,3810,5130,5140,5730,5740,7100,7110,8400,20480,21230,21240,22900,22910,24000,24010,24970,24980,25880,25890,26490,26500,27040],[60,700,710,1830,1840,2470,2480,3420,3430,3820,3830,4790,4800,5880,5890,6870,6880,8100,8110,8990,9000,9710,9720,10310,10320,10760,10770,11800]],[["قَالَ","رَبِّ","[wٱ][qجۡ]عَل","لّ[uِىٓ]","ءَايَ[fةً‌ۚ]","[fق]َالَ","ءَايَتُكَ","أَلَّا","تُكَلِّمَ","[wٱ][lل][gنّ]َاسَ","ثَلَ[nـٰ]ثَ","لَيَا[fلٍ]","[fس]َوِيًّا"],"Он сказал: «Господи! Назначь для меня знамение». Он сказал: «Знамением для тебя станет то, что ты не будешь говорить с людьми в течение трех ночей, будучи в полном здравии».",[400,1110,1120,2110,2120,2780,2790,5000,5010,6450,9950,10750,10760,12390,12400,13620,13630,15190,15200,16830,16840,18140,18150,20080,20090,21480],[30,620,630,1340,1350,2630,2640,4090,4100,5460,5470,6130,6140,7220,7230,8050,8060,9230,9240,10660,10670,11630,11640,13150,13160,14430]],[["فَخَرَجَ","عَلَىٰ","قَوۡمِه[nِۦ]","مِنَ","[wٱ]لۡمِحۡرَابِ","فَأَوۡحَ[uىٰٓ]","إِلَيۡهِمۡ","أَ[fن]","[fس]َبِّحُو[sاۡ]","بُكۡرَ[dةً]","[dو]َعَشِيًّا"],"Он вышел из молельни к своему народу и дал им понять: «Воздавайте хвалу по утрам и перед закатом!».",[300,1230,1240,2240,2250,3920,3930,4350,4360,6320,6330,14370,14380,15960,15970,17050,17060,18770,18780,20800,20810,22300],[30,830,840,1580,1590,2680,2690,3050,3060,4390,4400,6830,6840,7900,7910,9140,9150,10300,10310,12120,12130,13510]],[["يَ[nـٰ]يَحۡيَىٰ","خُذِ","[wٱ]لۡكِتَ[nـٰ]بَ","بِقُوَّ[dةٍ‌ۖ]","[dو]َءَاتَيۡنَ[nـٰ]هُ","[wٱ]لۡحُكۡمَ","صَبِيًّا"],"О Йахья (Иоанн)! Крепко держи Писание. Мы одарили его мудростью, пока он был еще ребенком,",[1030,2360,2370,3010,3020,4650,4660,6350,9450,11980,11990,13180,13190,14420],[110,1420,1430,1920,1930,3060,3070,4290,4300,6770,6780,7550,7560,8860]],[["وَحَنَا[dنًا]","[dم]ّ[Dِن]","[Dل]َّدُ[gنّ]َا","وَزَكَ[sو][nٰ][dةً‌ۖ]","[dو]َكَانَ","تَقِيًّا"],"а также состраданием от Нас и чистотой. Он был богобоязнен,",[300,1830,1840,3110,3120,5010,5020,6900,10200,11290,11300,12580],[30,1840,1850,2240,2250,4040,4050,5210,5220,6800,6810,8060]],[["وَبَرّ[iَۢا]","[iب]ِو[nٰ]لِدَيۡهِ","وَلَمۡ","يَكُ[fن]","[fج]َبَّارًا","عَصِيًّا"],"почтителен к родителям и не был гордецом и ослушником.",[300,2040,2050,4180,4190,4990,5000,6530,6540,8520,8530,10100],[30,1700,1710,3270,3280,3910,3920,5370,5380,6720,6730,7270]],[["وَسَلَ[nـٰ]مٌ","عَلَيۡهِ","يَوۡمَ","وُلِدَ","وَيَوۡمَ","يَمُوتُ","وَيَوۡمَ","يُ[qبۡ]عَثُ","حَيًّا"],"Мир ему в тот день, когда он родился, в тот день, когда он скончался, и в тот день, когда он будет воскрешен к жизни!",[350,2060,2070,3370,3380,4200,4210,5130,5140,6380,6390,7780,7790,8990,9000,10190,10200,11070],[60,1270,1280,2190,2200,2810,2820,3530,3540,4420,4430,5440,5450,6280,6290,7290,7300,7630]],[["وَ[wٱ]ذۡكُرۡ","فِى","[wٱ]لۡكِتَ[nـٰ]بِ","مَرۡيَمَ","إِذِ","[wٱ][fنت]َبَذَتۡ","مِنۡ","أَهۡلِهَا","مَكَا[fنًا]","[fش]َرۡقِيًّا"],"Помяни в Писании Марьям (Марию). Вот она ушла от своей семьи на восток",[250,870,880,1160,1170,2230,2240,2960,2970,3550,3560,5030,5040,5480,5490,6660,6670,8180,8190,9510],[30,790,800,1070,1080,2180,2190,3040,3050,3480,3490,5150,5160,5620,5630,6690,6700,8520,8530,9990]],[["فَ[wٱ]تَّخَذَتۡ","مِ[fن]","[fد]ُونِهِمۡ","حِجَا[fبًا]","[fف]َأَرۡسَلۡن[uَآ]","إِلَيۡهَا","رُوحَنَا","فَتَمَثَّلَ","لَهَا","بَشَ[fرًا]","[fس]َوِيًّا"],"и укрылась от них за завесой. Мы же послали к ней Нашего Духа (Джибрила), и он предстал перед ней в облике прекрасно сложенного человека.",[400,1560,1570,2410,2420,3400,3410,4980,4990,6290,6300,9030,9040,10380,10390,11950,11960,12670,12680,13980,13990,15210],[30,1250,1260,2280,2290,3310,3320,5020,5030,6240,6250,9340,9350,16040,16050,17450,17460,18040,18050,19320,19330,20660]],[["قَالَتۡ","إِ[gنّ][uِىٓ]","أَعُوذُ","بِ[wٱ][lل]رَّحۡمَ[nـٰ]نِ","مِ[fنك]َ","إِ[fن]","[fك]ُ[fنت]َ","تَقِيًّا"],"Она сказала: «Я прибегаю к Милостивому, чтобы Он защитил меня от тебя, если только ты богобоязнен».",[400,1350,1360,3830,3840,4800,4810,6460,6470,7600,11050,11970,11980,13150,13160,14170],[30,860,870,4030,4040,4910,4920,6470,6480,8050,8060,9350,9360,10560,10570,11810]],[["قَالَ","إِ[gنّ]َم[uَآ]","أَنَاۡ","رَسُولُ","رَبِّكِ","لِأَهَبَ","لَكِ","غُلَ[nـٰ][fمًا]","[fز]َكِيًّا"],"Он сказал: «Воистину, я послан твоим Господом, чтобы даровать тебе чистого мальчика».",[350,920,930,3530,3540,3920,3930,4990,5000,5940,5950,6880,6890,7330,7340,8850,8860,9970],[30,670,680,3350,3360,3810,3820,4800,4810,5740,5750,6670,6680,7140,7150,8960,8970,9540]],[["قَالَتۡ","أَ[gنّ]َىٰ","يَكُونُ","لِى","غُلَ[nـٰ][dمٌ]","[dو]َلَمۡ","يَمۡسَسۡنِى","بَشَ[dرٌ]","[dو]َلَمۡ","أَكُ","بَغِيًّا"],"Она сказала: «Как у меня может быть мальчик, если меня не касался мужчина, и я не была блудницей?».",[350,1290,1300,2570,2580,3640,3650,4020,4030,5780,5790,6370,6380,7960,7970,9340,9350,10000,10010,10510,10520,11490],[90,940,950,2390,2400,3460,3470,3830,3840,5300,5310,6250,6260,7710,7720,9130,9140,9940,9950,10420,10430,11670]],[["قَالَ","كَذ[nٰ]لِكِ","قَالَ","رَبُّكِ","هُوَ","عَلَىَّ","هَيِّ[dنٌ‌ۖ]","[dو]َلِنَ[qجۡ]عَلَهُ[uۥٓ]","ءَايَ[Dةً]","[Dل]ِّل[gنّ]َاسِ","وَرَحۡمَ[dةً]","[dم]ِّ[gنّ]َا‌ۚ","وَكَانَ","أَمۡ[dرًا]","[dم]َّ[qقۡ]ضِيًّا"],"Он сказал: «Вот так! Господь твой сказал: «Это для Меня легко. Мы сделаем его знамением для людей и милостью от Нас. Это дело уже предрешено!»»",[450,1000,1010,2320,2330,3090,3100,4080,4090,4570,4580,5490,5500,6700,12150,14110,14120,16050,16060,17970,17980,19930,19940,21500,26100,26990,27000,28580,28590,29690],[30,670,680,2060,2070,2820,2830,3630,3640,3990,4000,4990,5000,6710,6720,10020,10030,10970,10980,21020,21030,23180,23190,25250,25260,26170,26180,26660,26670,29911]],[["۞فَحَمَلَتۡهُ","فَ[wٱ][fنت]َبَذَتۡ","بِه[nِۦ]","مَكَا[fنًا]","[fق]َصِيًّا"],"Она понесла его (забеременела) и отправилась с ним в отдаленное место.",[350,1610,1620,3550,3560,4360,4370,5990,6000,7020],[30,1320,1330,3270,3280,4040,4050,6300,6310,7300]],[["فَأَج[oَا]ٓءَهَا","[wٱ]لۡمَخَاضُ","إِلَىٰ","جِذۡعِ","[wٱ][lل][gنّ]َخۡلَةِ","قَالَتۡ","يَ[nـٰ]لَيۡتَنِى","مِتُّ","قَ[qبۡ]لَ","هَ[nـٰ]ذَا","وَكُ[fنت]ُ","نَسۡ[dيًا]","[dم]َّ[fنس]ِيًّا"],"Родовые схватки привели ее к стволу финиковой пальмы, и она сказала: «Лучше бы я умерла до этого и была навсегда забытой!».",[450,2760,2770,4070,4080,4780,4790,5610,5620,7080,7090,8250,13910,15470,15480,16450,16460,17150,17160,18240,18250,19730,19740,20570,20580,22890],[30,3100,3110,4350,4360,5010,5020,5850,5860,7440,7450,8390,8400,11400,14060,14730,14740,15410,15420,16480,16490,18160,18170,18840,18850,21030]],[["فَنَادَ[nٮٰ]هَا","مِ[fن]","[fت]َحۡتِه[uَآ]","أَلَّا","تَحۡزَنِى","قَ[qدۡ]","جَعَلَ","رَبُّكِ","تَحۡتَكِ","سَرِيًّا"],"Тогда он (Иса или Джибрил) воззвал к ней из-под нее: «Не печалься! Господь твой создал под тобой ручей.",[350,2030,2040,2920,2930,3780,3790,6760,6770,8100,8110,8690,8700,9440,9450,10570,10580,11570,11580,12570],[30,1680,1690,2770,2780,5320,5330,6210,6220,7440,7450,7880,7890,8570,8580,9580,9590,10490,10500,11720]],[["وَهُزّ[uِىٓ]","إِلَيۡكِ","بِجِذۡعِ","[wٱ][lل][gنّ]َخۡلَةِ","تُسَ[nـٰ]قِ[qطۡ]","عَلَيۡكِ","رُطَ[fبًا]","[fج]َنِيًّا"],"Потряси на себя ствол пальмы, и на тебя попадают свежие финики.",[350,2580,2590,3600,3610,4670,4680,6160,6170,7390,7400,8450,8460,9950,9960,10890],[30,2480,2490,3390,3400,4360,4370,6060,6070,7260,7270,8120,8130,9910,9920,10310]],[["فَكُلِى","وَ[wٱ]شۡرَبِى","وَقَرِّى","عَيۡ[fنًا‌ۖ]","[fف]َإِ[gمّ]َا","تَرَيِ[gنّ]َ","مِنَ","[wٱ]لۡبَشَرِ","أَحَ[fدًا]","[fف]َقُول[uِىٓ]","إِ[gنّ]ِى","نَذَرۡتُ","لِلرَّحۡمَ[nـٰ]نِ","صَوۡ[fمًا]","[fف]َلَنۡ","أُكَلِّمَ","[wٱ]لۡيَوۡمَ","إِ[fنس]ِيًّا"],"Ешь, пей и радуйся! Если же увидишь кого-либо из людей, то скажи: «Я дала Милостивому обет хранить молчание и не стану сегодня разговаривать с людьми»».",[500,1400,1410,2760,2770,4080,4090,5500,11550,12890,12900,14550,14560,14980,14990,15990,16000,17390,17400,25850,25860,27430,27440,28450,28460,30230,30240,31730,31740,32560,32570,33820,33830,34880,34890,36700],[50,1050,1060,2240,2250,3400,3410,5080,5090,6560,6570,8490,8500,8890,8900,9820,9830,11240,11250,14180,14190,15500,15510,16400,16410,17950,17960,26390,26400,28070,28080,29210,29220,30150,30160,32040]],[["فَأَتَتۡ","بِه[nِۦ]","قَوۡمَهَا","تَحۡمِلُهُ[nۥ]‌ۖ","قَالُو[sاۡ]","يَ[nـٰ]مَرۡيَمُ","لَقَ[qدۡ]","جِئۡتِ","شَيۡـ[fـًٔا]","[fف]َرِيًّا"],"Она пришла к своим родным, неся его. Они сказали: «О Марьям (Мария)! Ты совершила тяжкий (или небывалый, или удивительный) проступок.",[350,1130,1140,1890,1900,3250,3260,4650,9600,10600,10610,12240,12250,12940,12950,13700,13710,15280,15290,