{"id":79,"v":[[["وَ[wٱ][lل][gنّ]َ[nـٰ]زِعَ[nـٰ]تِ","غَرۡقًا"],"Клянусь исторгающими души неверующих жестоко!",[200,2900,2910,4150],[40,2870,2880,4010]],[["وَ[wٱ][lل][gنّ]َ[nـٰ]شِطَ[nـٰ]تِ","نَشۡطًا"],"Клянусь извлекающими души верующих нежно!",[150,2950,2960,4110],[30,2890,2900,3860]],[["وَ[wٱ][lل]سَّ[nـٰ]بِحَ[nـٰ]تِ","سَ[qبۡ]حًا"],"Клянусь плывущими стремительно,",[200,2600,2610,3400],[30,1670,1680,2750]],[["فَ[wٱ][lل]سَّ[nـٰ]بِقَ[nـٰ]تِ","سَ[qبۡ]قًا"],"опережающими уверенно",[250,2620,2630,3830],[30,1670,1680,2750]],[["فَ[wٱ]لۡمُدَبِّر[nٰ]تِ","أَمۡرًا"],"и исполняющими повеления!",[30,2830,2840,3950],[30,1930,1940,2880]],[["يَوۡمَ","تَرۡجُفُ","[wٱ][lل]رَّاجِفَةُ"],"В тот день сотрясется сотрясающаяся (раздастся первый трубный глас, после которого творения умрут),",[40,810,820,2070,2080,3790],[50,640,650,1580,1590,2850]],[["تَتۡبَعُهَا","[wٱ][lل]رَّادِفَةُ"],"вслед за чем последует еще одно сотрясение (раздастся второй трубный глас, после которого начнется воскрешение),",[250,1700,1710,3830],[30,1120,1130,2460]],[["قُلُو[dبٌ]","[dي]َوۡمَئِ[dذٍ]","[dو]َاجِفَةٌ"],"В тот день затрепещут сердца,",[200,2050,2060,4380,4390,5890],[30,1800,1810,3900,3910,4880]],[["أَ[qبۡ]صَ[nـٰ]رُهَا","خَ[nـٰ]شِعَةٌ"],"а их взоры будут смиренны.",[30,2140,2150,3900],[30,1440,1450,2650]],[["يَقُولُونَ","أَءِ[gنّ]َا","لَمَرۡدُودُونَ","فِى","[wٱ]لۡحَافِرَةِ"],"Они говорят: «Неужели мы вернемся в прежнее состояние",[200,1910,1920,3900,3910,6370,6380,6750,6760,8620],[60,1360,1370,3230,3240,4920,4930,5170,5180,6340]],[["أَءِذَا","كُ[gنّ]َا","عِظَ[nـٰ][dمًا]","[dن]َّخِرَةً"],"после того, как станем истлевшими костями?!».",[250,1290,1300,2970,2980,4330,4340,6110],[30,780,790,2570,2580,3480,3490,5350]],[["قَالُو[sاۡ]","تِلۡكَ","إِ[fذًا]","[fك]َرَّةٌ","خَاسِرَةٌ"],"Они говорят: «Если так, то это - невыгодное возвращение!».",[250,1370,1380,2340,2350,3670,3680,5250,5260,6830],[30,820,830,1480,1490,2710,2720,3810,3820,4860]],[["فَإِ[gنّ]َمَا","هِىَ","زَ[qجۡ]رَ[dةٌ]","[dو][nٰ]حِدَةٌ"],"Но раздастся лишь один глас,",[30,2130,2140,2740,2750,4700,4710,6190],[30,2110,2120,2550,2560,3720,3730,5370]],[["فَإِذَا","ه[Fُم]","[Fب]ِ[wٱ][lل]سَّاهِرَةِ"],"и все они окажутся на поверхности земли.",[30,1220,1230,2370,2380,4490],[30,810,820,2120,2130,3530]],[["هَلۡ","أَتَ[nـٰ]كَ","حَدِيثُ","مُوسَىٰٓ"],"Дошел ли до тебя рассказ о Мусе (Моисее)?",[200,690,700,1910,1920,3750,3760,4860],[50,440,450,1280,1290,2190,2200,3430]],[["إِذۡ","نَادَ[nٮٰ]هُ","رَبُّهُ[nۥ]","بِ[wٱ]لۡوَادِ","[wٱ]لۡمُقَدَّسِ","طُوًى"],"Вот Господь его воззвал к нему в священной долине Тува (Това):",[150,560,570,2300,2310,3820,3830,5520,5530,7360,7370,8700],[30,340,350,1470,1480,2500,2510,3660,3670,4910,4920,5860]],[["ٱذۡهَ[qبۡ]","إِلَىٰ","فِرۡعَوۡنَ","إِ[gنّ]َهُ[nۥ]","طَغَىٰ"],"«Ступай к Фараону, ибо он преступил границы дозволенного,",[250,1070,1080,2110,2120,3630,3640,5450,5460,6740],[30,740,750,1390,1400,2480,2490,4290,4300,5240]],[["فَقُلۡ","هَل","لَّكَ","إِلَ[uىٰٓ]","أَ[fن]","[fت]َزَكَّىٰ"],"и скажи: «Не следует ли тебе очиститься?",[30,700,710,980,990,1860,1870,3850,3860,4810,4820,6750],[30,570,580,1230,1240,1450,1460,3710,3720,4700,4710,6080]],[["وَأَهۡدِيَكَ","إِلَىٰ","رَبِّكَ","فَتَخۡشَىٰ"],"Я укажу тебе путь к твоему Господу, и ты станешь богобоязнен»».",[150,1800,1810,2830,2840,4120,4130,6060],[30,1200,1210,1830,1840,2710,2720,4180]],[["فَأَرَ[nٮٰ]هُ","[wٱ]لۡأَيَةَ","[wٱ]لۡكُ[qبۡ]رَىٰ"],"Он показал ему величайшее знамение,",[300,1680,1690,3150,3160,4890],[30,1130,1140,2140,2150,3400]],[["فَكَذَّبَ","وَعَصَىٰ"],"но тот счел его ложью и ослушался,",[30,1530,1540,3200],[30,1010,1020,2100]],[["ثُ[gمّ]َ","أَ[qدۡ]بَرَ","يَسۡعَىٰ"],"а потом отвернулся, принявшись усердствовать.",[250,1310,1320,2540,2550,4190],[30,1330,1340,2230,2240,3270]],[["فَحَشَرَ","فَنَادَىٰ"],"Он собрал толпу и громко воззвал,",[40,1350,4100,5960],[30,760,770,2090]],[["فَقَالَ","أَنَاۡ","رَبُّكُمُ","[wٱ]لۡأَعۡلَىٰ"],"и сказал: «Я - ваш всевышний господь!».",[50,1290,1300,1870,1880,3470,3480,5290],[30,820,830,1190,1200,2310,2320,3640]],[["فَأَخَذَهُ","[wٱ]للَّهُ","نَكَالَ","[wٱ]لۡأَخِرَةِ","وَ[wٱ]لۡأُولَىٰٓ"],"Тогда Аллах подверг его наказанию как в Последней жизни, так и в первой жизни.",[300,1470,1480,2710,2720,3880,3890,5850,5860,8100],[70,1080,1090,1990,2000,2820,2830,4150,4160,5640]],[["إِ[gنّ]َ","فِى","ذ[nٰ]لِكَ","لَعِ[qبۡ]رَ[Dةً]","[Dل]ِّم[dَن]","[dي]َخۡشَىٰٓ"],"Воистину, в этом было назидание для тех, кто богобоязнен.",[200,1380,1390,2070,2080,3410,3420,4890,4900,6680,6690,8180],[30,1110,1120,1610,1620,2490,2500,3680,3690,5430,5440,6420]],[["ءَأَ[fنت]ُمۡ","أَشَدُّ","خَلۡقًا","أَمِ","[wٱ][lل]سَّم[oَا]ٓءُ‌ۚ","بَنَ[nـٰ]هَا"],"Вас ли труднее создать или небо? Он воздвиг его,",[300,2240,2250,3430,3440,4830,4840,5360,5370,8000,11350,12860],[30,1700,1710,2510,2520,3400,3410,3760,3770,7050,7060,8190]],[["رَفَعَ","سَمۡكَهَا","فَسَوَّ[nٮٰ]هَا"],"поднял его своды и сделал его совершенным.",[200,960,970,2500,2510,4910],[40,620,630,1740,1750,3430]],[["وَأَغۡطَشَ","لَيۡلَهَا","وَأَخۡرَجَ","ضُحَ[nـٰ]هَا"],"Он сделал темной ночь его (неба) и вывел его утреннюю зарю.",[30,1500,1510,3030,3040,4580,4590,6300],[30,1070,1080,2120,2130,3110,3120,4390]],[["وَ[wٱ]لۡأَرۡضَ","بَعۡدَ","ذ[nٰ]لِكَ","دَحَ[nـٰ]هَآ"],"После этого Он распростер землю,",[200,1590,1600,2520,2530,3780,3790,5500],[30,1020,1030,1630,1640,2510,2520,3720]],[["أَخۡرَجَ","مِنۡهَا","م[oَا]ٓءَهَا","وَمَرۡعَ[nـٰ]هَا"],"вывел из нее воду и пастбища",[200,1270,1280,2540,2550,5140,5150,7460],[30,800,810,1610,1620,4400,4410,6000]],[["وَ[wٱ]لۡجِبَالَ","أَرۡسَ[nـٰ]هَا"],"и утвердил на ней горы",[150,1780,1790,3870],[30,1240,1250,2700]],[["مَتَ[nـٰ][Dعًا]","[Dل]َّكُمۡ","وَلِأَنۡعَ[nـٰ]مِكُمۡ"],"на пользу вам и вашему скоту.",[250,1320,1330,2690,2700,5560],[80,750,760,1790,1800,3730]],[["فَإِذَا","ج[oَا]ٓءَتِ","[wٱ][lل]طّ[xَا]ٓ[gمّ]َةُ","[wٱ]لۡكُ[qبۡ]رَىٰ"],"Когда же наступит Величайшее бедствие (День воскресения),",[30,1230,1240,3850,4200,8110,8120,9830],[30,860,870,3320,3330,7550,7560,8730]],[["يَوۡمَ","يَتَذَكَّرُ","[wٱ]لۡإِ[fنس]َ[nـٰ]نُ","مَا","سَعَىٰ"],"в тот день человек вспомнит о том, в чем он усердствовал,",[40,840,850,2740,2750,5120,5130,5690,5700,7020],[70,530,540,1830,1840,3830,3840,4180,4190,5090]],[["وَبُرِّزَتِ","[wٱ]لۡجَحِيمُ","لِم[dَن]","[dي]َرَىٰ"],"и Ад будет ясно виден тем, кто будет видеть.",[250,1790,1800,3290,3300,4770,4780,5550],[30,1240,1250,2350,2360,3960,3970,4530]],[["فَأَ[gمّ]َا","مَ[fن]","[fط]َغَىٰ"],"Тому, кто преступил границы дозволенного",[30,2370,2380,3100,3110,4290],[30,1530,1540,2450,2460,3280]],[["وَءَاثَرَ","[wٱ]لۡحَيَ[sو][nٰ]ةَ","[wٱ][lل]دُّنۡيَا"],"и отдал предпочтение мирской жизни,",[200,1500,1510,3080,3090,4620],[30,1020,1030,2150,2160,3370]],[["فَإِ[gنّ]َ","[wٱ]لۡجَحِيمَ","هِىَ","[wٱ]لۡمَأۡوَىٰ"],"пристанищем будет Ад.",[30,1420,1430,3010,3020,3650,3660,5600],[30,1430,1440,2510,2520,2980,2990,4320]],[["وَأَ[gمّ]َا","مَنۡ","خَافَ","مَقَامَ","رَبِّه[nِۦ]","وَنَهَى","[wٱ][lل][gنّ]َفۡسَ","عَنِ","[wٱ]لۡهَوَىٰ"],"Тому же, кто боялся предстать перед своим Господом и удерживал себя от страстей,",[50,1900,1910,2340,2350,3510,3520,4720,4730,6340,6350,7270,7280,8730,8740,9390,9400,10890],[30,1950,1960,2330,2340,3080,3090,3960,3970,5090,5100,5690,5700,7350,7360,7850,7860,9010]],[["فَإِ[gنّ]َ","[wٱ]لۡجَ[gنّ]َةَ","هِىَ","[wٱ]لۡمَأۡوَىٰ"],"пристанищем будет Рай.",[30,1590,1600,3560,3570,4120,4130,5930],[30,1250,1260,3000,3010,3420,3430,4900]],[["يَسۡــَٔلُونَكَ","عَنِ","[wٱ][lل]سَّاعَةِ","أَيَّانَ","مُرۡسَ[nـٰ]هَا"],"Тебя спрашивают о Часе: «Когда же он настанет?».",[150,2090,2100,2790,2800,4390,4400,5930,5940,7890],[60,1460,1470,1930,1940,3120,3130,4150,4160,5560]],[["فِيمَ","أَ[fنت]َ","مِ[fن]","[fذ]ِكۡرَ[nٮٰ]هَآ"],"К чему тебе упоминать об этом?",[350,1160,1170,2670,2680,3720,3730,5140],[30,550,560,1800,1810,3100,3110,4560]],[["إِلَىٰ","رَبِّكَ","مُ[fنت]َهَ[nـٰ]هَآ"],"Только твой Господь ведает об этом.",[200,880,890,2260,2270,4920],[30,570,580,1430,1440,3820]],[["إِ[gنّ]َم[uَآ]","أَ[fنت]َ","مُ[fنذ]ِرُ","م[dَن]","[dي]َخۡشَ[nـٰ]هَا"],"Воистину, ты - всего лишь предостерегающий увещеватель для тех, кто опасается этого.",[200,3030,3040,4420,4430,5820,5830,6830,6840,8860],[30,1680,1690,4190,4200,5740,5750,7060,7070,8300]],[["كَأَ[gنّ]َهُمۡ","يَوۡمَ","يَرَوۡنَهَا","لَمۡ","يَلۡبَث[oُوٓ][sاۡ]","إِلَّا","عَشِيَّةً","أَوۡ","ضُحَ[nـٰ]هَا"],"В тот день, когда они увидят его, им покажется, что они провели в этом мире лишь послеполуденные часы или утро.",[250,2110,2120,3040,3050,5020,5030,5520,5530,8230,8240,9390,9400,11430,11440,12030,12040,13800],[30,2030,2040,2700,2710,4070,4080,4450,4460,6680,6690,7560,7570,9140,9150,9620,9630,11090]]]}