{"id":87,"v":[[["سَبِّحِ","[wٱ]سۡمَ","رَبِّكَ","[wٱ]لۡأَعۡلَى"],"Славь имя Господа твоего Всевышнего,",[300,1240,1250,1930,1940,3140,3150,5100],[40,730,740,1180,1190,2080,2090,3440]],[["ٱلَّذِى","خَلَقَ","فَسَوَّىٰ"],"Который сотворил все сущее и всему придал соразмерность,",[30,1390,1400,2290,2300,4220],[30,960,970,1610,1620,3320]],[["وَ[wٱ]لَّذِى","قَدَّرَ","فَهَدَىٰ"],"Который предопределил судьбу творений и указал путь,",[30,1440,1450,2740,2750,4340],[30,970,980,1780,1790,3070]],[["وَ[wٱ]لَّذ[uِىٓ]","أَخۡرَجَ","[wٱ]لۡمَرۡعَىٰ"],"Который взрастил пастбища,",[150,2380,2390,3530,3540,5360],[30,2530,2540,3290,3300,4870]],[["فَجَعَلَهُ[nۥ]","غُث[oَا]ٓءً","أَحۡوَىٰ"],"а потом превратил их в темный сор.",[30,1890,1900,4400,4410,5970],[30,1160,1170,3720,3730,4740]],[["سَنُ[qقۡ]رِئُكَ","فَلَا","تَ[fنس]َىٰٓ"],"Мы позволим тебе прочесть Коран, и ты не забудешь ничего,",[200,1690,1700,2640,2650,4860],[40,1270,1280,1900,1910,4020]],[["إِلَّا","مَا","ش[oَا]ٓءَ","[wٱ]للَّهُ‌ۚ","إِ[gنّ]َهُ[nۥ]","يَعۡلَمُ","[wٱ]لۡجَهۡرَ","وَمَا","يَخۡفَىٰ"],"кроме того, что пожелает Аллах. Он знает явное и то, что сокрыто.",[30,1400,1410,2010,2020,3740,3750,5300,10300,12110,12120,13290,13300,14600,14610,15620,15630,17270],[30,810,820,1180,1190,3330,3340,6330,6340,8120,8130,8970,8980,9930,9940,10600,10610,11770]],[["وَنُيَسِّرُكَ","لِلۡيُسۡرَىٰ"],"Мы облегчим тебе путь к легчайшему.",[30,2250,2260,4460],[30,1470,1480,2960]],[["فَذَكِّرۡ","إ[dِن]","[dن]َّفَعَتِ","[wٱ][lل]ذِّكۡرَىٰ"],"Наставляй же людей, если напоминание принесет пользу.",[30,1590,1600,2600,2610,4150,4160,5570],[30,920,930,2210,2220,3010,3020,4440]],[["سَيَذَّكَّرُ","م[dَن]","[dي]َخۡشَىٰ"],"Воспримет его тот, кто страшится,",[200,2220,2230,3530,3540,4900],[40,1620,1630,3230,3240,4290]],[["وَيَتَجَ[gنّ]َبُهَا","[wٱ]لۡأَشۡقَى"],"и уклонится от него самый несчастный,",[150,2570,2580,4580],[30,2400,2410,3770]],[["ٱلَّذِى","يَصۡلَى","[wٱ][lل][gنّ]َارَ","[wٱ]لۡكُ[qبۡ]رَىٰ"],"который войдет в Огонь величайший.",[150,1670,1680,2720,2730,4170,4180,5950],[30,1040,1050,1700,1710,3400,3410,4810]],[["ثُ[gمّ]َ","لَا","يَمُوتُ","فِيهَا","وَلَا","يَحۡيَىٰ"],"Не умрет он там и не будет жить.",[30,1170,1180,1780,1790,3010,3020,4380,4390,5430,5440,6960],[30,1720,1730,2100,2110,3040,3050,3980,3990,4680,4690,5950]],[["قَ[qدۡ]","أَفۡلَحَ","مَ[fن]","[fت]َزَكَّىٰ"],"Преуспел тот, кто очистился,",[200,610,620,1910,1920,2780,2790,4790],[30,400,410,1310,1320,2500,2510,4020]],[["وَذَكَرَ","[wٱ]سۡمَ","رَبِّه[nِۦ]","فَصَلَّىٰ"],"поминал имя своего Господа и совершал намаз.",[150,1530,1540,1980,1990,3510,3520,5480],[30,790,800,1220,1230,2330,2340,3860]],[["بَلۡ","تُؤۡثِرُونَ","[wٱ]لۡحَيَ[sو][nٰ]ةَ","[wٱ][lل]دُّنۡيَا"],"Но нет! Вы отдаете предпочтение мирской жизни,",[300,730,740,2610,2620,4260,4270,5830],[30,360,370,1630,1640,2750,2760,3950]],[["وَ[wٱ]لۡأَخِرَةُ","خَيۡ[dرٌ]","[dو]َأَ[qبۡ]قَىٰٓ"],"хотя Последняя жизнь - лучше и дольше.",[250,2290,2300,4000,4010,5780],[30,1520,1530,3120,3130,4470]],[["إِ[gنّ]َ","هَ[nـٰ]ذَا","لَفِى","[wٱ][lل]صُّحُفِ","[wٱ]لۡأُولَىٰ"],"Воистину, это записано в первых свитках -",[200,1270,1280,2680,2690,3190,3200,4470,4480,6420],[30,1350,1360,2320,2330,2690,2700,3640,3650,4850]],[["صُحُفِ","إِ[qبۡ]ر[nٰ]هِيمَ","وَمُوسَىٰ"],"свитках Ибрахима (Авраама) и Мусы (Моисея).",[250,970,980,2950,2960,5800],[60,740,750,2410,2420,4470]]]}