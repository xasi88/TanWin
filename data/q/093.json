{"id":93,"v":[[["وَ[wٱ][lل]ضُّحَىٰ"],"Клянусь утром!",[250,2040],[60,1610]],[["وَ[wٱ]لَّيۡلِ","إِذَا","سَجَىٰ"],"Клянусь ночью, когда она успокаивается (или покрывается мраком)!",[250,1460,1470,2480,2490,3850],[30,1040,1050,1610,1620,2690]],[["مَا","وَدَّعَكَ","رَبُّكَ","وَمَا","قَلَىٰ"],"Не покинул тебя твой Господь и не возненавидел.",[300,860,870,2420,2430,3670,3680,4600,4610,5790],[70,490,500,1520,1530,2440,2450,3050,3060,3870]],[["وَلَلۡأَخِرَةُ","خَيۡ[Dرٌ]","[Dل]َّكَ","مِنَ","[wٱ]لۡأُولَىٰ"],"Воистину, будущее для тебя лучше, чем настоящее.",[300,2620,2630,3670,3680,4580,4590,5090,5100,7050],[30,1700,1710,2430,2440,3070,3080,3450,3460,4970]],[["وَلَسَوۡفَ","يُعۡطِيكَ","رَبُّكَ","فَتَرۡضَىٰٓ"],"Господь твой непременно одарит тебя, и ты будешь удовлетворен.",[250,1690,1700,3330,3340,4540,4550,6430],[30,1060,1070,2260,2270,3110,3120,4590]],[["أَلَمۡ","يَجِ[qدۡ]كَ","يَتِي[fمًا]","[fف]َـَٔـاوَىٰ"],"Разве Он не нашел тебя сиротой и не дал тебе приют?",[250,780,790,2060,2070,3990,4000,6020],[30,590,600,1400,1410,3360,3370,4800]],[["وَوَجَدَكَ","ضَآل[fاًّ]","[fف]َهَدَىٰ"],"Он нашел тебя заблудшим и повел прямым путем.",[350,1700,1710,4970,4980,9795],[30,1010,1020,5520,5530,6840]],[["وَوَجَدَكَ","ع[oَا]ٓئِل[fاً]","[fف]َأَغۡنَىٰ"],"Он нашел тебя бедным и обогатил.",[250,1520,1530,4510,4520,6430],[30,1040,1050,4140,4150,5600]],[["فَأَ[gمّ]َا","[wٱ]لۡيَتِيمَ","فَلَا","تَ[qقۡ]هَرۡ"],"Посему не притесняй сироту!",[450,1710,1720,3270,3280,4240,4250,5630],[30,1580,1590,2720,2730,3390,3400,4290]],[["وَأَ[gمّ]َا","[wٱ][lل]سّ[oَا]ٓئِلَ","فَلَا","تَنۡهَرۡ"],"И не гони просящего!",[300,1760,1770,4200,4210,5230,5240,6740],[30,1280,1290,4130,4140,4780,4790,5720]],[["وَأَ[gمّ]َا","بِنِعۡمَةِ","رَبِّكَ","فَحَدِّثۡ"],"И возвещай о милости своего Господа.",[450,2140,2150,3580,3590,4860,4870,6320],[30,1710,1720,2790,2800,3710,3720,4960]]]}