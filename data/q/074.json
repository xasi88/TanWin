,4380,4390,6230],[30,580,590,1090,1100,1530,1540,2780,2790,5520]],[["كَأَ[gنّ]َهُمۡ","حُمُ[dرٌ]","[dم]ُّسۡتَ[fنف]ِرَةٌ"],"словно напуганные ослы,",[350,2310,2320,4080,4090,6430],[30,1460,1470,2830,2840,4860]],[["فَرَّتۡ","مِ[fن]","[fق]َسۡوَرَةِۭ"],"бегущие от стрелка (или льва)?",[300,1450,1460,2640,2650,3950],[30,740,750,1930,1940,2930]],[["بَلۡ","يُرِيدُ","كُلُّ","[wٱ]مۡرِى[dٍٕ]","[dم]ِّنۡهُمۡ","أ[dَن]","[dي]ُؤۡتَىٰ","صُحُ[dفًا]","[dم]ُّنَشَّرَةً"],"Но ведь каждый из них желает получить развернутые свитки.",[350,670,680,1980,1990,3010,3020,4620,4630,5890,5900,6880,6890,7950,7960,9800,9810,10990],[30,350,360,1110,1120,1710,1720,3320,3330,3980,3990,4990,5000,5640,5650,7580,7590,8210]],[["كَلَّا‌ۖ","بَل","لَّا","يَخَافُونَ","[wٱ]لۡأَخِرَةَ"],"Но нет! Они не боятся Последней жизни.",[300,1550,3900,4080,4090,4950,4960,6830,6840,8610],[30,1330,1340,1770,1780,2090,2100,3280,3290,4350]],[["كَلّ[uَآ]","إِ[gنّ]َهُ[nۥ]","تَذۡكِرَةٌ"],"Но нет! Это есть Назидание.",[300,2430,2440,4230,4240,5590],[30,1030,1040,3500,3510,4470]],[["فَمَ[fن]","[fش][oَا]ٓءَ","ذَكَرَهُۥ"],"Помянет его тот, кто захочет.",[400,1440,1450,3420,3430,4450],[30,1120,1130,3270,3280,3930]],[["وَمَا","يَذۡكُرُونَ","إِلّ[uَآ]","أ[dَن]","[dي]َش[oَا]ٓءَ","[wٱ]للَّهُ‌ۚ","هُوَ","أَهۡلُ","[wٱ][lل]تَّ[qقۡ]وَىٰ","وَأَهۡلُ","[wٱ]لۡمَغۡفِرَةِ"],"Но они не помянут его, если этого не пожелает Аллах. Он - Тот, Кто достоин страха и способен на прощение.",[350,1070,1080,2900,2910,4980,4990,6130,6140,8310,8320,9850,12540,12910,12920,13790,13800,15340,15350,16510,16520,18130],[30,530,540,1750,1760,3900,3910,4940,4950,6800,6810,10390,10400,10770,10780,11350,11360,12520,12530,13380,13390,14660]]]}