{"id":78,"v":[[["عَ[gمّ]َ","يَتَس[oَا]ٓءَل[pُو]نَ"],"О чем они расспрашивают друг друга?",[450,1790,1800,5510],[30,1240,1250,4030],[582,3,3,3],30],[["عَنِ","[wٱ][lل][gنّ]َبَإِ","[wٱ]لۡعَظ[pِي]مِ"],"О великой вести,",[0,1340,1350,2170,2180,3890],[80,1220,1230,1810,1820,4560],[582,3,3,3,3],30],[["ٱلَّذِى","هُمۡ","فِيهِ","مُخۡتَلِف[pُو]نَ"],"относительно которой они расходятся во мнениях.",[200,1670,1680,2300,2310,3410,3420,5830],[30,1070,1080,1500,1510,2310,2320,5380],[582,3,3,3,3,3],30],[["كَلَّا","سَيَعۡلَم[pُو]نَ"],"Но нет, они узнают!",[300,1440,1450,3630],[30,920,930,3020],[582,4,4,4],30],[["ثُ[gمّ]َ","كَلَّا","سَيَعۡلَم[pُو]نَ"],"Еще раз нет, они узнают!",[250,1350,1360,2640,2650,4870],[30,1250,1260,2180,2190,5380],[582,4,4,4,4],30],[["أَلَمۡ","نَ[qجۡ]عَلِ","[wٱ]لۡأَرۡضَ","مِهَ[nـٰ]دًا"],"Разве Мы не сделали землю ложем,",[200,790,800,1950,1960,3160,3170,4750],[30,580,590,1590,1600,2600,2610,3480],[582,4,4,4,4,4],30],[["وَ[wٱ]لۡجِبَالَ","أَوۡتَادًا"],"а горы - колышками?",[150,1930,1940,3920],[80,1420,1430,3060],[582,5,5,5],30],[["وَخَلَ[qقۡ]نَ[nـٰ]كُمۡ","أَزۡو[nٰ]جًا"],"Мы сотворили вас парами,",[150,2680,2690,4250],[30,2010,2020,3610],[582,5,5,5],30],[["وَجَعَلۡنَا","نَوۡمَكُمۡ","سُبَاتًا"],"и сделали ваш сон отдыхом,",[150,2020,2030,3530,3540,5200],[30,1570,1580,2670,2680,3650],[582,5,5,5,6],30],[["وَجَعَلۡنَا","[wٱ]لَّيۡلَ","لِبَاسًا"],"и сделали ночь покрывалом,",[100,1470,1480,2800,2810,4350],[30,1150,1160,2130,2140,3050],[582,6,6,6,6],30],[["وَجَعَلۡنَا","[wٱ][lل][gنّ]َهَارَ","مَعَاشًا"],"и сделали день жалованием,",[150,1640,1650,3570,3580,5330],[30,1430,1440,3130,3140,4580],[582,6,6,6,6],30],[["وَبَنَيۡنَا","فَوۡقَكُمۡ","سَ[qبۡ][fعًا]","[fش]ِدَادًا"],"и воздвигли над вами семь твердынь,",[200,1960,1970,3530,3540,5150,5160,6800],[30,1410,1420,2580,2590,4180,4190,5760],[582,6,7,7,7,7],30],[["وَجَعَلۡنَا","سِرَا[dجًا]","[dو]َهَّاجًا"],"и установили пылающий светильник,",[40,1780,1790,3900,3910,5930],[80,1390,1400,2380,2390,4530],[582,7,7,7,7],30],[["وَأَ[f