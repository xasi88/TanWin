{"id":56,"v":[[["إِذَا","وَقَعَتِ","[wٱ]لۡوَاقِعَةُ"],"Когда наступит Событие (День воскресения),",[550,1190,1200,2370,2380,4020],[30,610,620,1620,1630,2970]],[["لَيۡسَ","لِوَ[qقۡ]عَتِهَا","كَاذِبَةٌ"],"никто не сочтет его наступление ложью.",[550,1270,1280,3270,3280,4560],[40,730,740,2300,2310,3360]],[["خَافِضَ[Dةٌ]","[Dر]َّافِعَةٌ"],"Оно унижает и возвышает.",[650,1940,1950,3680],[30,1440,1450,2660]],[["إِذَا","رُجَّتِ","[wٱ]لۡأَرۡضُ","رَجًّا"],"Когда земля сильно содрогнется,",[450,1130,1140,2260,2270,3340,3350,4460],[30,550,560,1540,1550,2480,2490,3510]],[["وَبُسَّتِ","[wٱ]لۡجِبَالُ","بَسًّا"],"когда горы раскрошатся на мелкие кусочки,",[450,1770,1780,3110,3120,4170],[40,1130,1140,2310,2320,3410]],[["فَكَانَتۡ","هَب[oَا]ٓ[dءً]","[dم]ُّ[iنۢب]َثًّا"],"а затем превратятся в развеянный прах,",[950,1950,1960,5130,5140,6880],[30,1080,1090,5530,5540,6750]],[["وَكُ[fنت]ُمۡ","أَزۡو[nٰ][fجًا]","[fث]َلَ[nـٰ]ثَةً"],"вы разделитесь на три группы.",[800,2590,2600,4670,4680,6070],[50,1950,1960,3160,3170,4140]],[["فَأَصۡحَ[nـٰ]بُ","[wٱ]لۡمَيۡمَنَةِ","م[uَآ]","أَصۡحَ[nـٰ]بُ","[wٱ]لۡمَيۡمَنَةِ"],"Одни будут по правую сторону. Кто же будет по правую сторону?",[900,2270,2280,3990,4000,5560,5570,7070,7080,8500],[30,1310,1320,2720,2730,2790,2800,5560,5570,6780]],[["وَأَصۡحَ[nـٰ]بُ","[wٱ]لۡمَشۡــَٔمَةِ","م[uَآ]","أَصۡحَ[nـٰ]بُ","[wٱ]لۡمَشۡــَٔمَةِ"],"Другие же будут по левую сторону. Кто же будет по левую сторону?",[450,1930,1940,3700,3710,5430,5440,6860,6870,8360],[30,1340,1350,2810,2820,2880,2890,5980,5990,7220]],[["وَ[wٱ][lل]سَّ[nـٰ]بِقُونَ","[wٱ][lل]سَّ[nـٰ]بِق[pُو]نَ"],"И будут опередившие их всех в добре, которые опередят их и в Раю.",[600,2630,2640,4880],[30,1830,1840,5350]],[["أُ[sوۡ]لَ[oـٰٓ]ئِكَ","[wٱ]لۡمُقَرَّب[pُو]نَ"],"Это будут приближенные,",[550,2940,2950,5230],[100,2530,2540,6200]],[["فِى","جَ[gنّ]َ[nـٰ]تِ","[wٱ][lل][gنّ]َع[pِي]مِ"],"которые пребудут в Садах блаженства.",[550,950,960,2990,3000,4700],[30,430,440,2560,2570,6140]],[["ثُلَّ[dةٌ]","[dم]ِّنَ","[wٱ]لۡأَوَّل[pِي]نَ"],"Многие из них - из первых поколений,",[650,2410,2420,2600,2610,4630],[70,2220,2230,2550,2560,5750]],[["وَقَلِي[dلٌ]","[dم]ِّنَ","[wٱ]لۡأَخِر[pِي]نَ"],"и лишь немногие - из последних.",[550,2490,2500,2900,2910,5070],[30,2430,2440,2740,2750,6240]],[["عَلَىٰ","سُرُ[dرٍ]","[dم]َّوۡضُونَةٍ"],"Они будут лежать на расшитых ложах",[450,1170,1180,2800,2810,4290],[30,620,630,2360,2370,3510]],[["مُّتَّكِــِٔينَ","عَلَيۡهَا","مُتَقَ[nـٰ]بِل[pِي]نَ"],"друг против друга, прислонившись.",[500,2350,2360,3880,3890,6200],[50,1570,1580,2830,2840,6490]],[["يَطُوفُ","عَلَيۡهِمۡ","وِلۡد[nٰ][dنٌ]","[dم]ُّخَلَّد[pُو]نَ"],"Вечно юные отроки будут обходить их",[550,1470,1480,2990,3000,5080,5090,6970],[30,820,830,2110,2120,4580,4590,7560]],[["بِأَكۡوَا[dبٍ]","[dو]َأَبَارِيقَ","وَكَأۡ[dسٍ]","[dم]ّ[dِن]","[dم]َّع[pِي]نٍ"],"с чашами, кувшинами и кубками с родниковым напитком (вином),",[350,2530,2540,4550,4560,6550,6560,7430,7440,8560],[30,1440,1450,4020,4030,6050,6060,7320,7330,9870]],[["لَّا","يُصَدَّعُونَ","عَنۡهَا","وَلَا","يُ[fنز]ِف[pُو]نَ"],"от которого не болит голова и не теряют рассудок,",[550,1050,1060,2990,3000,4250,4260,5210,5220,7320],[40,450,460,2040,2050,3000,3010,3710,3720,7740]],[["وَفَ[nـٰ]كِهَ[dةٍ]","[dم]ِّ[gمّ]َا","يَتَخَيَّر[pُو]نَ"],"с фруктами, которые они выбирают,",[800,3120,3130,4520,4530,6780],[30,2380,2390,3900,3910,7760]],[["وَلَحۡمِ","طَيۡ[dرٍ]","[dم]ِّ[gمّ]َا","يَشۡتَه[pُو]نَ"],"и мясом птиц, которое они желают.",[450,1230,1240,2880,2890,4310,4320,6130],[30,800,810,2740,2750,4630,4640,7990]],[["وَحُورٌ","ع[pِي]نٌ"],"Их женами будут черноокие, большеглазые девы,",[450,1790,1800,2050],[30,1080,1090,3910]],[["كَأَمۡثَ[nـٰ]لِ","[wٱ][lل]لُّؤۡلُوِٕ","[wٱ]لۡمَكۡن[pُو]نِ"],"подобные сокрытым жемчужинам.",[450,1980,1990,3350,3360,5130],[30,1280,1290,2410,2420,5700]],[["جَز[oَا]ٓ[iءَۢ]","[iب]ِمَا","كَانُو[sاۡ]","يَعۡمَل[pُو]نَ"],"Таково воздаяние за то, что они совершали.",[750,3390,3400,4210,4220,5470,5480,7270],[50,3610,3620,4340,4350,5380,5390,8470]],[["لَا","يَ