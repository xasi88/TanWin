{"id":53,"v":[[["وَ[wٱ][lل][gنّ]َ[qجۡ]مِ","إِذَا","هَوَىٰ"],"Клянусь звездой, когда она падает (или частью Корана, когда она нисходит)!",[350,1880,1890,2750,2760,3990],[30,2280,2290,2970,2980,3980],[526,2,2,2,2],27],[["مَا","ضَلَّ","صَاحِبُكُمۡ","وَمَا","غَوَىٰ"],"Не заблудился ваш товарищ и не сошел с пути.",[200,560,570,1410,1420,3200,3210,3980,3990,5200],[30,410,420,1120,1130,2560,2570,3200,3210,4280],[526,2,2,2,2,2,2],27],[["وَمَا","يَ[fنط]ِقُ","عَنِ","[wٱ]لۡهَوَىٰٓ"],"Он не говорит по прихоти.",[30,710,720,2180,2190,2770,2780,4200],[30,640,650,2400,2410,2890,2900,4320],[526,2,2,3,3,3],27],[["إِنۡ","هُوَ","إِلَّا","وَحۡ[dىٌ]","[dي]ُوحَىٰ"],"Это - всего лишь внушаемое ему откровение.",[300,700,710,1200,1210,2310,2320,3920,3930,5600],[30,420,430,860,870,1760,1770,3280,3290,4490],[526,3,3,3,3,3,3],27],[["عَلَّمَهُ[nۥ]","شَدِيدُ","[wٱ]لۡقُوَىٰ"],"Научил его обладающий могучей силой",[200,1640,1650,2840,2850,4340],[30,1290,1300,2270,2280,3670],[526,3,3,3,3],27],[["ذُو","مِرَّ[fةٍ]","[fف]َ[wٱ]سۡتَوَىٰ"],"и прекрасным сложением (или благоразумием). Он вознесся (или выпрямился)",[400,960,970,2660,2670,4560],[40,530,540,2420,2430,3920],[526,4,4,4,4],27],[["وَهُوَ","بِ[wٱ]لۡأُفُقِ","[wٱ]لۡأَعۡلَىٰ"],"на наивысшем горизонте.",[250,860,870,2290,2300,4010],[30,670,680,1860,1870,3390],[526,4,4,4,4],27],[["ثُ[gمّ]َ","دَنَا","فَتَدَلَّىٰ"],"Потом он приблизился и спустился.",[350,1330,1340,2200,2210,4210],[30,1240,1250,1950,1960,3620],[526,4,4,4,4],27],[["فَكَانَ","قَابَ","قَوۡسَيۡنِ","أَوۡ","أَ[qدۡ]نَىٰ"],"Он находился от него (Джибрил от Мухаммада или Мухаммад от Аллаха) на расстоянии двух луков или даже ближе.",[750,1430,1440,2320,2330,3820,3830,4400,4410,5860],[30,890,900,1580,1590,2790,2800,3230,3240,4290],[526,5,5,5,5,5,5],27],[["فَأَوۡحَ[uىٰٓ]","إِلَىٰ","عَ[qبۡ]دِه[nِۦ]","م[uَآ]","أَوۡحَىٰ"],"Он внушил Его рабу откровение,",[450,2670,2680,3550,3560,5120,5130,6780,6790,8220],[30,2480,2490,3080,3090,4310,4320,5930,5940,7220],[526,5,5,5,5,5,5],27],[["مَا","كَذَبَ","[wٱ]لۡفُؤَادُ","مَا","رَأَىٰٓ"],"и сердце не солгало о том, что он увидел.",[300,780,790,1570,1580,3050,3060,3570,3580,4810],[60,460,470,1160,1170,2330,2340,2700,2710,3510],[526,6,6,6,6,6,6],27],[["أَفَتُمَ[nـٰ]رُونَهُ[nۥ]","عَلَىٰ","مَا","يَرَىٰ"],"Неужели вы будете препираться с ним о том, что он увидел?",[200,2750,2760,3660,3670,4270,4280,5360],[70,2250,2260,3060,3070,3500,3510,4530],[526,6,6,6,6,6],27],[["وَلَقَ[qدۡ]","رَءَاهُ","نَزۡلَةً","أُخۡرَىٰ"],"Он уже видел его другое нисхождение",[300,1070,1080,2330,2340,3700,3710,5000],[40,820,830,1800,1810,2930,2940,4140],[526,6,6,7,7,7],27],[["عِ[fند]َ","سِ[qدۡ]رَةِ","[wٱ]لۡمُ[fنت]َهَىٰ"],"у Лотоса крайнего предела,",[300,1280,1290,2390,2400,4730],[80,1370,1380,2360,2370,4830],[526,7,7,7,7],27],[["عِ[fند]َهَا","جَ[gنّ]َةُ","[wٱ]لۡمَأۡوَىٰٓ"],"возле которого находится Сад пристанища.",[300,2010,2020,3490,3500,5350],[30,1930,1940,3660,3670,5050],[526,7,7,7,7],27],[["إِذۡ","يَغۡشَى","[wٱ][lل]سِّ[qدۡ]رَةَ","مَا","يَغۡشَىٰ"],"Тогда Лотос покрыло то, что покрыло (золотая саранча, или группы ангелов, или повеление Аллаха).",[250,540,550,1440,1450,2760,2770,3320,3330,4810],[30,380,390,1080,1090,2270,2280,2700,2710,4020],[526,8,8,8,8,8,8],27],[["مَا","زَاغَ","[wٱ]لۡبَصَرُ","وَمَا","طَغَىٰ"],"Его же взор не уклонился в сторону и не излишествовал,",[350,800,810,1690,1700,2910,2920,3700,3710,4850],[50,460,470,1230,1240,2190,2200,2820,2830,3870],[526,8,8,8,8,8,8],27],[["لَقَ[qدۡ]","رَأَىٰ","مِنۡ","ءَايَ[nـٰ]تِ","رَبِّهِ","[wٱ]لۡكُ[qبۡ]رَىٰٓ"],"и он увидел величайшие из знамений своего Господа.",[300,810,820,1830,1840,2450,2550,3910,3920,5080,5090,6730],[30,610,620,1350,1360,1790,1800,2980,2990,3970,3980,5290],[526,8,8,9,9,9,9,9],27],[["أَفَرَءَيۡتُمُ","[wٱ][lل]لَّ[nـٰ]تَ","وَ[wٱ]لۡعُزَّىٰ"],"Не видели ли вы аль-Лат и аль-Уззу,",[350,2140,2150,3310,3320,5490],[30,1610,1620,2620,2630,4520],[526,9,9,9,9],27],[["وَمَنَ[sو][nٰ]ةَ","[wٱ][lل]ثَّالِثَةَ","[wٱ]لۡأُخۡرَىٰٓ"],"и еще третью - Манат?",[200,1900,2050,3340,3350,5220],[30,1160,1170,2580,2590,4020],[526,9,10,10,10],27],[["أَلَكُمُ","[wٱ][lل]ذَّكَرُ","وَلَهُ","[wٱ]لۡأُ[fنث]َىٰ"],"Неужели у вас - потомки мужского пола, а у Него - женского?",[400,1270,1280,2510,2520,3320,3330,5560],[30,870,880,1820,1830,2570,2580,4760],[526,10,10,10,10,10],27],[["تِلۡكَ","إِ[fذًا]","[fق]ِسۡمَ[fةٌ]","[fض]ِيزَىٰٓ"],"Это было бы несправедливым распределением.",[500,1110,1120,2410,2420,4280,4290,5880],[30,610,620,1080,1090,4390,4400,5770],[526,10,10,10,11,11],27],[["إِنۡ","هِىَ","إِلّ[uَآ]","أَسۡم[oَا]ٓ[fءٌ]","[fس]َ[gمّ]َيۡتُمُوه[uَآ]","أَ[fنت]ُمۡ","وَءَاب[oَا]ٓؤُك[hُم]","[hم]ّ[uَآ]","أَ[fنز]َلَ","[wٱ]للَّهُ","بِهَا","مِ[fن]","[fس]ُلۡطَ[nـٰ]نٍ‌ۚ","إ[dِن]","[dي]َتَّبِعُونَ","إِلَّا","[wٱ][lل]ظَّ[gنّ]َ","وَمَا","تَهۡوَى","[wٱ]لۡأَ[fنف]ُسُ‌ۖ","وَلَقَ[qدۡ]","ج[oَا]ٓءَه[hُم]","[hم]ّ[Dِن]","[Dر]َّبِّهِمُ","[wٱ]لۡهُدَىٰٓ"],"Они - всего лишь имена, которыми нарекли их вы и ваши отцы, относительно которых Аллах не ниспослал никакого доказательства. Они следуют лишь предположениям и тому, чего желают души, хотя верное руководство от их Господа уже явилось к ним.",[300,710,720,1270,1280,3450,3460,6470,6480,17980,17990,19680,19690,23650,23660,25230,25240,26710,26720,27960,27970,28900,28910,29810,29820,31750,37350,38240,38250,40130,40140,40940,40950,42480,42490,43390,43400,44290,44300,46300,50850,51810,51820,54710,54720,54800,54810,56630,56640,58060],[30,430,440,880,890,2880,2890,6430,6440,13030,13040,15830,15840,19860,19870,19880,19890,22880,22890,23810,23820,24530,24540,25710,25720,29390,29400,30340,30350,31890,31900,32530,32540,34110,34120,34760,34770,35510,35520,38310,38320,39130,39140,42960,42970,43100,43110,44530,44540,45670],[526,11,11,11,11,11,11,11,11,11,12,12,12,12,12,12,12,12,12,12,12,13,13,13,13,13,13],27],[["أَمۡ","لِلۡإِ[fنس]َ[nـٰ]نِ","مَا","تَمَ[gنّ]َىٰ"],"Или же для человека уготовано то, чего он желает?",[300,740,750,3360,3370,3850,3860,5990],[40,390,400,2830,2840,3200,3210,5670],[526,13,13,13,13,13],27],[["فَلِلَّهِ","[wٱ]لۡأَخِرَةُ","وَ[wٱ]لۡأُولَىٰ"],"Аллаху при