{"id":71,"v":[[["إِ[gنّ][uَآ]","أَرۡسَلۡنَا","نُوحًا","إِلَىٰ","قَوۡمِه[uِۦٓ]","أَنۡ","أَ[fنذ]ِرۡ","قَوۡمَكَ","مِ[fن]","[fق]َ[qبۡ]لِ","أ[dَن]","[dي]َأۡتِيَهُمۡ","عَذَابٌ","أَل[pِي]مٌ"],"Мы отправили Нуха (Ноя) к его народу: «Предостереги свой народ прежде, чем их постигнут мучительные страдания».",[40,2530,2540,3770,3780,4580,4590,5140,5150,7470,7480,7920,7930,9130,9140,10150,17260,18090,18100,18780,18790,19620,19630,20730,20740,21910,21920,22890],[150,2730,2740,3850,3860,4560,4570,5060,5070,7130,7140,7490,7500,8740,8750,9520,9530,10550,10560,11160,11170,12110,12120,13140,13150,14100,14110,16140]],[["قَالَ","يَ[nـٰ]قَوۡمِ","إِ[gنّ]ِى","لَكُمۡ","نَذِي[dرٌ]","[dم]ُّب[pِي]نٌ"],"Он сказал: «О мой народ! Воистину, я для вас - предостерегающий и разъясняющий увещеватель.",[300,810,820,2010,2020,3140,3150,3800,3810,5340,5350,6170],[30,500,510,1420,1430,2830,2840,3360,3370,5030,5040,7260]],[["أَنِ","[wٱ]عۡبُدُو[sاۡ]","[wٱ]للَّهَ","وَ[wٱ]تَّقُوهُ","وَأَطِيع[pُو]نِ"],"Поклоняйтесь Аллаху, бойтесь Его и повинуйтесь мне!",[300,500,510,1170,1180,1970,1980,3390,3400,5060],[30,230,240,860,870,1590,1600,2740,2750,5290]],[["يَغۡفِرۡ","لَك[hُم]","[hم]ِّ[fن]","[fذ]ُنُوبِكُمۡ","وَيُؤَخِّرۡكُمۡ","إِلَ[uىٰٓ]","أَجَ[dلٍ]","[dم]ُّسَ[gمّ]ًى‌ۚ","إِ[gنّ]َ","أَجَلَ","[wٱ]للَّهِ","إِذَا","ج[oَا]ٓءَ","لَا","يُؤَخَّرُ‌ۖ","لَوۡ","كُ[fنت]ُمۡ","تَعۡلَم[pُو]نَ"],"Он простит вам ваши грехи и предоставит вам отсрочку до назначенного срока. Воистину, когда срок Аллаха наступает, он уже не откладывается. Если бы вы только знали!».",[200,860,870,2080,2090,2780,2790,4200,4210,5980,5990,6300,6310,9170,9180,11100,15850,16710,16720,17410,17420,18410,18420,19140,19150,21000,21010,21530,21540,23000,26250,26600,26610,28210,28220,29780],[100,700,710,1920,1930,2620,2630,3810,3820,5280,5290,6950,6960,8580,8590,10750,10760,12020,12030,12580,12590,13400,13410,13940,13950,15950,15960,16280,16290,17300,17310,17610,17620,19100,19110,21670]],[["قَالَ","رَبِّ","إِ[gنّ]ِى","دَعَوۡتُ","قَوۡمِى","لَيۡل[dاً]","[dو]َنَهَارًا"],"Он сказал: «Господи! Я призывал мой народ ночью и днем,",[200,760,770,1560,1570,2850,2860,3910,3920,4920,4930,5610,5620,7740],[30,480,490,1160,1170,2480,2490,3270,3280,4070,4080,4670,4680,6890]],[["فَلَمۡ","يَزِ[qدۡ]هُمۡ","دُع[oَا]ٓء[uِىٓ]","إِلَّا","فِرَارًا"],"но мои проповеди лишь ускорили их бегство.",[300,740,750,2050,2060,5480,5490,6470,6480,7870],[30,440,450,1370,1380,5680,5690,6410,6420,7610]],[["وَإِ[gنّ]ِى","كُلَّمَا","دَعَوۡتُهُمۡ","لِتَغۡفِرَ","لَهُمۡ","جَعَل[oُوٓ][sاۡ]","أَصَ[nـٰ]بِعَهُمۡ","ف[uِىٓ]","ءَاذَانِهِمۡ","وَ[wٱ]سۡتَغۡشَوۡ[sاۡ]","ثِيَابَهُمۡ","وَأَصَرُّو[sاۡ]","وَ[wٱ]سۡتَكۡبَرُو[sاۡ]","[wٱ]سۡتِكۡبَارًا"],"Каждый раз, когда я призывал их, чтобы Ты простил их, они затыкали пальцами уши и укрывались одеждами. Они упорствовали и надменно превозносились.",[150,1540,1550,2790,2800,4190,4200,5450,5460,6190,6200,12580,12590,14410,14420,15830,15840,17670,17680,19100,19110,20720,20730,22200,27380,28700,28710,30580],[30,1540,1550,2500,2510,3710,3720,4700,4710,5220,5230,7080,7090,8360,8370,10080,10090,18830,18840,19960,19970,21180,21190,22360,22370,23460,23470,25010]],[["ثُ[gمّ]َ","إِ[gنّ]ِى","دَعَوۡتُهُمۡ","جِهَارًا"],"Затем я призывал их открыто.",[30,1020,1030,2430,2440,3910,3920,5190],[30,1060,1070,2490,2500,3710,3720,4910]],[["ثُ[gمّ]َ","إِ[gنّ][uِىٓ]","أَعۡلَ[fنت]ُ","لَهُمۡ","وَأَسۡرَرۡتُ","لَهُمۡ","إِسۡرَارًا"],"Затем я обращался к ним всенародно и говорил с ними наедине.",[300,1210,1220,3880,3890,5530,5540,6270,6280,7740,7750,8490,8500,10070],[30,1070,1080,3730,3740,5230,5240,5810,5820,6910,6920,7440,7450,8790]],[["فَقُلۡتُ","[wٱ]سۡتَغۡفِرُو[sاۡ]","رَبَّكُمۡ","إِ[gنّ]َهُ[nۥ]","كَانَ","غَفَّارًا"],"Я говорил: «Просите у вашего Господа прощения, ведь Он - Всепрощающий.",[250,1000,1010,2630,2640,3950,3960,5470,5480,6330,6340,7950],[30,700,710,1880,1890,2830,2840,4500,4510,5120,5130,6550]],[["يُرۡسِلِ","[wٱ][lل]سَّم[oَا]ٓءَ","عَلَيۡك[hُم]","[hم]ِّ[qدۡ]رَارًا"],"Он ниспошлет вам с неба обильные дожди,",[200,1010,1020,3090,3100,4860,4870,6250],[30,740,750,3030,3040,5060,5070,6330]],[["وَيُمۡدِ[qدۡ]ك[Fُم]","[Fب]ِأَمۡو[nٰ][dلٍ]","[dو]َبَنِينَ","وَيَ[qجۡ]عَل","لَّكُمۡ","جَ[gنّ]َ[nـٰ][dتٍ]","[dو]َيَ[qجۡ]عَل","لَّكُمۡ","أَنۡهَ[nـٰ]رًا"],"поддержит вас имуществом и детьми, взрастит для вас сады и создаст для вас реки.",[200,2060,2070,4250,4260,5430,5440,11230,11240,12010,12020,14460,14470,15430,15440,16460,16470,18210],[30,1920,1930,3180,3190,4810,4820,5580,5590,6390,6400,8150,8160,9730,9740,10400,10410,11740]],[["مَّا","لَكُمۡ","لَا","تَرۡجُونَ","لِلَّهِ","وَقَارًا"],"Почему вы не чтите величия Аллаха?",[200,680,690,1450,1460,1960,1970,3290,3300,4560,4570,5970],[50,400,410,980,990,1350,1360,2360,2370,3330,3340,4440]],[["وَقَ[qدۡ]","خَلَقَكُمۡ","أَ[qطۡ]وَارًا"],"Он ведь создавал вас по этапам.",[250,740,750,2110,2120,3410],[30,450,460,1540,1550,2860]],[["أَلَمۡ","تَرَوۡ[sاۡ]","كَيۡفَ","خَلَقَ","[wٱ]للَّهُ","سَ[qبۡ]عَ","سَمَ[nـٰ]و[nٰ][fتٍ]","[fط]ِبَاقًا"],"Неужели вы не видели, как Аллах создал семь небес одно над другим,",[200,800,810,1510,1520,2260,2270,3050,3060,4040,4050,4780,4790,7290,7300,8690],[30,500,510,1080,1090,1650,1660,2250,2260,2990,3000,3570,3580,5650,5660,6830]],[["وَجَعَلَ","[wٱ]لۡقَمَرَ","فِيهِ[gنّ]َ","نُو[dرًا]","[dو]َجَعَلَ","[wٱ][lل]شَّمۡسَ","سِرَاجًا"],"сделал луну светлой, а солнце сделал светильником?",[150,940,950,2000,2010,3650,3660,5070,5080,5990,6000,7100,7110,8510],[30,690,700,1480,1490,2910,2920,3440,3450,4990,5000,5730,5740,6970]],[["وَ[wٱ]للَّهُ","أَ[iنۢب]َتَك[hُم]","[hم]ِّنَ","[wٱ]لۡأَرۡضِ","نَبَاتًا"],"Аллах вырастил вас из земли, словно растения.",[250,1310,1320,3710,3720,4080,4090,5110,5120,6570],[30,930,940,3690,3700,3940,3950,4740,4750,5870]],[["ثُ[gمّ]َ","يُعِيدُكُمۡ","فِيهَا","وَيُخۡرِجُكُمۡ","إِخۡرَاجًا"],"Потом Он вернет вас туда и вновь выведет оттуда.",[250,1180,1190,2790,2800,3940,3950,5810,5820,7470],[30,970,980,2140,2150,2980,2990,4360,4370,5720]],[["وَ[wٱ]للَّهُ","جَعَلَ","لَكُمُ","[wٱ]لۡأَرۡضَ","بِسَاطًا"],"Аллах сделал для вас землю ковром,",[350,1610,1620,2430,2440,3190,3200,4280,4290,5850],[30,920,930,1580,1590,2160,2170,2930,2940,4160]],[["لِّتَسۡلُكُو[sاۡ]","مِنۡهَا","سُبُل[fاً]","[fف]ِجَاجًا"],"чтобы вы ходили по ней широкими дорогами»».",[300,1900,1910,2970,2980,4430,4440,6040],[30,1130,1140,1840,1850,3350,3360,4410]],[["قَالَ","نُو[Dحٌ]","[Dر]َّبِّ","إِ[gنّ]َهُمۡ","عَصَوۡنِى","وَ[wٱ]تَّبَعُو[sاۡ]","م[Dَن]","[Dل]َّمۡ","يَزِ[qدۡ]هُ","مَالُهُ[nۥ]","وَوَلَدُهُ[uۥٓ]","إِلَّا","خَسَارًا"],"Нух (Ной) сказал: «Господи! Они ослушались меня и последовали за тем, чье богатство и чьи дети приносят им только убыток.",[200,940,950,1730,1740,2900,2910,4330,4340,5930,5940,7650,13520,13700,13710,14470,14480,15610,15620,17100,17110,19750,19760,20850,20860,22430],[30,580,590,1170,1180,1900,1910,3440,3450,4540,4550,5660,5670,5880,5890,6370,6380,7180,7190,8140,8150,10720,10730,11360,11370,12580]],[["وَمَكَرُو[sاۡ]","مَكۡ[fرًا]","[fك]ُبَّارًا"],"Они замыслили тяжкую хитрость",[200,1490,1500,3070,3080,4920],[30,970,980,2440,2450,3800]],[["وَقَالُو[sاۡ]","لَا","تَذَرُ[gنّ]َ","ءَالِهَتَكُمۡ","وَلَا","تَذَرُ[gنّ]َ","وَد[dًّا]","[dو]َلَا","سُوَا[dعًا]","[dو]َلَا","يَغُوثَ","وَيَعُوقَ","وَنَسۡرًا"],"и сказали: «Не отрекайтесь от ваших богов: Вадда, Сувы, Йагуса, Йаука и Насра».",[150,1650,1660,2180,2190,3940,3950,5950,5960,6800,6810,8680,8690,10150,17750,22610,22620,23950,23960,25450,25460,26640,26650,28180,28190,29550],[30,930,940,1240,1250,2830,2840,4150,4160,4680,4690,6110,6120,6690,6700,7860,7870,8760,8770,9930,9940,10800,10810,11750,11760,12920]],[["وَقَ[qدۡ]","أَضَلُّو[sاۡ]","كَثِي[dرًا‌ۖ]","[dو]َلَا","تَزِدِ","[wٱ][lل]ظَّ[nـٰ]لِمِينَ","إِلَّا","ضَلَ[nـٰ]لاً"],"Они уже ввели в заблуждение многих. Не приумножай же беззаконникам ничего, кроме заблуждения!».",[300,890,900,2290,2300,4150,8600,9280,9290,10080,10090,12070,12080,13140,13150,14530],[30,520,530,1460,1470,2980,2990,3520,3530,4120,4130,5520,5530,6270,6280,7650]],[["مِّ[gمّ]َا","خَط[oِيٓ]ـَٔ[nـٰ]تِهِمۡ","أُغۡرِقُو[sاۡ]","فَأُ[qدۡ]خِلُو[sاۡ]","نَا[fرًا]","[fف]َلَمۡ","يَجِدُو[sاۡ]","لَه[hُم]","[hم]ِّ[fن]","[fد]ُونِ","[wٱ]للَّهِ","أَ[fنص]َارًا"],"За свои грехи они были потоплены и ввергнуты в Огонь. Они не нашли себе помощников вместо Аллаха.",[300,1670,1680,5050,5060,6370,6380,8110,8120,9650,9660,10460,10470,11650,17430,18720,18730,19760,19770,20630,20640,21760,21770,23950],[40,1660,1670,4800,4810,5730,5740,6900,6910,8300,8310,8860,8870,9700,9710,13310,13320,14340,14350,15030,15040,15580,15590,17690]],[["وَقَالَ","نُو[Dحٌ]","[Dر]َّبِّ","لَا","تَذَرۡ","عَلَى","[wٱ]لۡأَرۡضِ","مِنَ","[wٱ]لۡكَ[nـٰ]فِرِينَ","دَيَّارًا"],"Нух (Ной) сказал: «Господи! Не оставь на земле ни одного неверующего жителя!",[250,1260,1270,2400,2410,3270,3280,3770,3780,4520,4530,5150,5160,6390,6400,6850,6860,8990,9000,10780],[30,770,780,1300,1310,2070,2080,2380,2390,2980,2990,3380,3390,4220,4230,4550,4560,5880,5890,7340]],[["إِ[gنّ]َكَ","إِ[fن]","[fت]َذَرۡهُمۡ","يُضِلُّو[sاۡ]","عِبَادَكَ","وَلَا","يَلِد[oُوٓ][sاۡ]","إِلَّا","فَاجِ[fرًا]","[fك]َفَّارًا"],"Если ты оставишь их, они введут в заблуждение Твоих рабов и породят только грешных неверующих.",[250,1550,1560,2490,2500,3870,3880,5440,5450,6870,6880,7770,7780,10330,10340,11420,11430,13390,13400,15260],[30,1350,1360,2280,2290,3280,3290,4240,4250,5320,5330,5860,5870,7980,7990,8730,8740,10410,10420,11840]],[["رَّبِّ","[wٱ]غۡفِرۡ","لِى","وَلِو[nٰ]لِدَىَّ","وَلِمَ[fن]","[fد]َخَلَ","بَيۡتِىَ","مُؤۡمِ[dنًا]","[dو]َلِلۡمُؤۡمِنِينَ","وَ[wٱ]لۡمُؤۡمِنَ[nـٰ]تِ","وَلَا","تَزِدِ","[wٱ][lل]ظَّ[nـٰ]لِمِينَ","إِلَّا","تَبَارَۢا"],"Господи! Прости меня и моих родителей и тех, кто вошел в мой дом верующим, а также верующих мужчин и женщин. А беззаконникам не приумножай ничего, кроме погибели!».",[300,980,990,1710,1720,2500,2510,4610,4620,6180,6190,6990,7000,8110,8120,9700,17440,19790,19800,22080,22090,22920,22930,23750,23760,25800,25810,26890,26900,28430],[40,590,600,1050,1060,1630,1640,3210,3220,4760,4770,5360,5370,6140,6150,6860,6870,9270,9280,10870,10880,11410,11420,12070,12080,13680,13690,14530,14540,16100]]]}